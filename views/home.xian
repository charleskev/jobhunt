                    </div>

                    <!-- Benefit 2 -->
                    <div class="flex items-start gap-4 p-4 rounded-xl hover:bg-blue-50 transition">
                        <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-shield-alt text-blue-600 text-2xl"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-xl text-gray-800 mb-2">Secure & Transparent</h3>
                            <p class="text-gray-600">Your data is protected and the hiring process is completely transparent.</p>
                        </div>
                    </div>

                    <!-- Benefit 3 -->
                    <div class="flex items-start gap-4 p-4 rounded-xl hover:bg-green-50 transition">
                        <div class="w-14 h-14 bg-green-100 rounded-2xl flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-chart-line text-green-600 text-2xl"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-xl text-gray-800 mb-2">Real-Time Tracking</h3>
                            <p class="text-gray-600">Monitor your application status and get instant notifications on updates.</p>
                        </div>
                    </div>

                    <!-- Benefit 4 -->
                    <div class="flex items-start gap-4 p-4 rounded-xl hover:bg-yellow-50 transition">
                        <div class="w-14 h-14 bg-yellow-100 rounded-2xl flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-hands-helping text-yellow-600 text-2xl"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-xl text-gray-800 mb-2">Dedicated Support</h3>
                            <p class="text-gray-600">Our HR team is here to help you throughout the entire hiring process.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

