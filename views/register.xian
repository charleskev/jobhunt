<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Municipal Job Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        .gradient-bg {
            background: linear-gradient(135deg, #0ea5e9 0%, #1e40af 100%);
        }
        .step-active {
            background: #0ea5e9;
            color: white;
        }
        .step-completed {
            background: #2563eb;
            color: white;
        }
        .form-panel {
            background: rgba(255, 255, 255, 0.98);
            border: 1px solid rgba(148, 163, 184, 0.25);
            border-radius: 2rem;
            box-shadow: 0 35px 80px rgba(15, 23, 42, 0.12);
            padding: 2.25rem;
        }
        .form-field {
            border-radius: 1rem;
            border: 1px solid #cbd5e1;
            background: #f8fafc;
        }
        .form-field:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.14);
        }
        .indicator-bar {
            height: 0.5rem;
            border-radius: 9999px;
            background: #c7d2fe;
        }
        .indicator-bar.active {
            background: #3b82f6;
        }
    </style>
</head>
<body class="bg-gray-50">

    <div class="min-h-screen flex">
        <!-- Left Side - Branding -->
        <div class="hidden lg:flex lg:w-1/2 gradient-bg items-center justify-center p-12">
            <div class="text-white text-center max-w-lg">
                <i class="fas fa-users text-9xl mb-8"></i>
                <h1 class="text-5xl font-bold mb-4">Join Our Community</h1>
                <p class="text-xl text-gray-100 mb-8">
                    Start your career journey as a job applicant today
                </p>
                
                <div class="bg-white/10 backdrop-blur-lg rounded-lg p-6 text-left space-y-4">
                    <div class="flex items-start">
                        <i class="fas fa-check-circle text-2xl mr-4 text-green-300"></i>
                        <div>
                            <h3 class="font-bold text-lg">Easy Application</h3>
                            <p class="text-sm text-gray-200">Apply to multiple jobs with one profile</p>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle text-2xl mr-4 text-green-300"></i>
                        <div>
                            <h3 class="font-bold text-lg">Track Progress</h3>
                            <p class="text-sm text-gray-200">Monitor your application status in real-time</p>
                        </div>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle text-2xl mr-4 text-green-300"></i>
                        <div>
                            <h3 class="font-bold text-lg">Get Notified</h3>
                            <p class="text-sm text-gray-200">Receive updates about new opportunities</p>
                        </div>
                    </div>
                </div>

                <!-- Note for HR/Managers -->
                <div class="mt-8 bg-blue-500/20 border border-blue-300 rounded-lg p-4 text-sm">
                    <p class="text-blue-100">
                        <i class="fas fa-info-circle mr-2"></i>
                        <strong>For HR Managers & Department Managers:</strong> Contact your system administrator to create an account.
                    </p>
                </div>
            </div>
        </div>

        <!-- Right Side - Registration Form -->
        <div class="w-full lg:w-1/2 flex items-center justify-center p-8">
            <div class="w-full max-w-md form-panel">
                <!-- Header -->
                <div class="text-center mb-8">
                    <a href="/" class="inline-block">
                        <div class="bg-sky-600 w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-sky-500/20">
                            <i class="fas fa-city text-3xl text-white"></i>
                        </div>
                    </a>
                    <h2 class="text-3xl font-bold text-slate-900">Create Applicant Account</h2>
                    <p class="text-slate-600 mt-2">Join thousands of job applicants and start your career journey</p>
                </div>

                <!-- Error Message -->
                {{#if error}}
                <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
                        <p class="text-red-700">{{error}}</p>
                    </div>
                </div>
                {{/if}}

                <!-- Registration Form -->
                <form action="/auth/register" method="POST" class="space-y-5">
                    <!-- Name Fields -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-slate-800 mb-2">
                                First Name
                            </label>
                            <input 
                                type="text" 
                                name="firstName" 
                                required
                                class="w-full px-4 py-3 form-field focus:outline-none transition"
                                placeholder="Juan"
                            >
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-800 mb-2">
                                Last Name
                            </label>
                            <input 
                                type="text" 
                                name="lastName" 
                                required
                                class="w-full px-4 py-3 form-field focus:outline-none transition"
                                placeholder="Dela Cruz"
                            >
                        </div>
                    </div>

                    <!-- Email -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-800 mb-2">
                            <i class="fas fa-envelope mr-2 text-slate-400"></i>Email Address
                        </label>
                        <input 
                            type="email" 
                            name="email" 
                            required
                            class="w-full px-4 py-3 form-field focus:outline-none transition"
                            placeholder="your.email@example.com"
                        >
                    </div>

                    <!-- Contact Number -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-800 mb-2">
                            <i class="fas fa-phone mr-2 text-slate-400"></i>Contact Number
                        </label>
                        <input 
                            type="tel" 
                            name="contactNumber" 
                            required
                            class="w-full px-4 py-3 form-field focus:outline-none transition"
                            placeholder="09XX XXX XXXX"
                        >
                    </div>

                    <!-- Password -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-800 mb-2">
                            <i class="fas fa-lock mr-2 text-slate-400"></i>Password
                        </label>
                        <div class="relative">
                            <input 
                                type="password" 
                                name="password" 
                                id="password"
                                required
                                minlength="8"
                                class="w-full px-4 py-3 form-field focus:outline-none transition"
                                placeholder="Minimum 8 characters with uppercase, number & symbol"
                                oninput="checkPasswordStrength(this.value)"
                            >
                            <button 
                                type="button"
                                onclick="togglePassword('password', 'toggleIcon1')"
                                class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600"
                            >
                                <i class="fas fa-eye" id="toggleIcon1"></i>
                            </button>
                        </div>
                        <!-- Password Strength Indicator -->
                        <div class="mt-2 flex gap-1">
                            <div id="strength1" class="h-1 flex-1 bg-gray-300 rounded"></div>
                            <div id="strength2" class="h-1 flex-1 bg-gray-300 rounded"></div>
                            <div id="strength3" class="h-1 flex-1 bg-gray-300 rounded"></div>
                            <div id="strength4" class="h-1 flex-1 bg-gray-300 rounded"></div>
                        </div>
                        <p id="strengthText" class="text-xs text-gray-600 mt-1">Password strength: <span id="strengthLabel">-</span></p>
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-800 mb-2">
                            <i class="fas fa-lock mr-2 text-slate-400"></i>Confirm Password
                        </label>
                        <div class="relative">
                            <input 
                                type="password" 
                                name="confirmPassword" 
                                id="confirmPassword"
                                required
                                minlength="6"
                                class="w-full px-4 py-3 form-field focus:outline-none transition"
                                placeholder="Re-enter password"
                            >
                            <button 
                                type="button"
                                onclick="togglePassword('confirmPassword', 'toggleIcon2')"
                                class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600"
                            >
                                <i class="fas fa-eye" id="toggleIcon2"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Terms and Conditions -->
                    <div class="flex items-start">
                        <input 
                            type="checkbox" 
                            name="terms" 
                            id="terms"
                            required
                            class="w-4 h-4 mt-1 text-sky-600 border-gray-300 rounded focus:ring-sky-500"
                        >
                        <label for="terms" class="ml-3 text-sm text-gray-700">
                            I agree to the 
                            <a href="/terms" class="text-sky-600 hover:text-sky-700 font-semibold">Terms of Service</a> 
                            and 
                            <a href="/privacy" class="text-sky-600 hover:text-sky-700 font-semibold">Privacy Policy</a>
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <button 
                        type="submit" 
                        class="w-full bg-gradient-to-r from-sky-600 to-blue-700 text-white py-3 rounded-xl font-bold hover:opacity-95 transition duration-300 shadow-xl shadow-sky-500/20 flex items-center justify-center gap-2"
                    >
                        <i class="fas fa-user-plus"></i>Create Account
                    </button>
                </form>

                <!-- Divider -->
                <div class="relative my-6">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-300"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-4 bg-gray-50 text-gray-500">Already have an account?</span>
                    </div>
                </div>

                <!-- Login Link -->
                <div class="text-center"><a href="/auth/login" class="inline-block w-full border-2 border-sky-600 text-sky-600 py-3 rounded-xl font-bold hover:bg-sky-50 transition shadow-sm">
                        <i class="fas fa-sign-in-alt mr-2"></i>Sign In Instead
                    </a>
                </div>

                <!-- Back to Home -->
                <div class="mt-6 text-center">
                    <a href="/" class="text-sm text-gray-600 hover:text-gray-800">
                        <i class="fas fa-arrow-left mr-2"></i>Back to Homepage
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Toggle Password Visibility
        function togglePassword(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const toggleIcon = document.getElementById(iconId);
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

        // Password Strength Checker
        function checkPasswordStrength(password) {
            let strength = 0;
            const strengthLabels = ['Weak', 'Fair', 'Good', 'Strong'];
            const strengthColors = ['bg-red-500', 'bg-yellow-500', 'bg-blue-500', 'bg-green-500'];

            // Reset indicators
            for (let i = 1; i <= 4; i++) {
                document.getElementById(`strength${i}`).className = 'h-1 flex-1 bg-gray-300 rounded';
            }

            if (!password) return;

            // Check length
            if (password.length >= 8) strength++;
            if (password.length >= 12) strength++;

            // Check uppercase
            if (/[A-Z]/.test(password)) strength++;

            // Check numbers
            if (/[0-9]/.test(password)) strength++;

            // Check special characters
            if (/[^A-Za-z0-9]/.test(password)) strength++;

            // Update indicators
            for (let i = 0; i < Math.min(strength, 4); i++) {
                document.getElementById(`strength${i + 1}`).className = `h-1 flex-1 ${strengthColors[Math.min(strength - 1, 3)]} rounded`;
            }

            const label = strength >= 4 ? 'Strong' : strength === 3 ? 'Good' : strength === 2 ? 'Fair' : 'Weak';
            document.getElementById('strengthLabel').textContent = label;
        }

        // Email Validation
        function isValidEmail(email) {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return emailRegex.test(email);
        }

        // Phone Validation (Philippine format)
        function isValidPhoneNumber(phone) {
            const phoneRegex = /^(09|\+639)\d{9}$/;
            return phoneRegex.test(phone.replace(/\s/g, ''));
        }

        // Show Error
        function showError(message) {
            const errorDiv = document.createElement('div');
            errorDiv.className = 'bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded animate-fadeIn';
            errorDiv.innerHTML = `
                <div class="flex items-center">
                    <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
                    <p class="text-red-700">${message}</p>
                </div>
            `;
            const form = document.querySelector('form');
            form.parentElement.insertBefore(errorDiv, form);
            
            setTimeout(() => {
                errorDiv.style.opacity = '0';
                errorDiv.style.transition = 'opacity 0.3s ease';
                setTimeout(() => errorDiv.remove(), 300);
            }, 5000);
        }

        // Show Success
        function showSuccess(message) {
            const successDiv = document.createElement('div');
            successDiv.className = 'bg-green-50 border-l-4 border-green-500 p-4 mb-6 rounded animate-fadeIn';
            successDiv.innerHTML = `
                <div class="flex items-center">
                    <i class="fas fa-check-circle text-green-500 mr-3"></i>
                    <p class="text-green-700">${message}</p>
                </div>
            `;
            const form = document.querySelector('form');
            form.parentElement.insertBefore(successDiv, form);
            
            setTimeout(() => {
                successDiv.style.opacity = '0';
                successDiv.style.transition = 'opacity 0.3s ease';
                setTimeout(() => successDiv.remove(), 300);
            }, 5000);
        }

        // Validate All Fields
        function validateRegistrationForm() {
            const firstName = document.querySelector('input[name="firstName"]').value.trim();
            const lastName = document.querySelector('input[name="lastName"]').value.trim();
            const email = document.querySelector('input[name="email"]').value.trim();
            const phone = document.querySelector('input[name="contactNumber"]').value.trim();
            const password = document.querySelector('input[name="password"]').value;
            const confirmPassword = document.querySelector('input[name="confirmPassword"]').value;
            const terms = document.querySelector('input[name="terms"]').checked;

            if (!firstName) {
                showError('First name is required');
                return false;
            }
            if (!lastName) {
                showError('Last name is required');
                return false;
            }
            if (!email || !isValidEmail(email)) {
                showError('Please enter a valid email address');
                return false;
            }
            if (!phone || !isValidPhoneNumber(phone)) {
                showError('Please enter a valid Philippine phone number (09XX XXX XXXX)');
                return false;
            }
            if (!password || password.length < 8) {
                showError('Password must be at least 8 characters');
                return false;
            }
            if (!/[A-Z]/.test(password) || !/[0-9]/.test(password) || !/[^A-Za-z0-9]/.test(password)) {
                showError('Password must contain uppercase letter, number, and special character');
                return false;
            }
            if (password !== confirmPassword) {
                showError('Passwords do not match');
                return false;
            }
            if (!terms) {
                showError('You must agree to Terms of Service and Privacy Policy');
                return false;
            }
            return true;
        }

        // Real-time Validation
        function setupRealTimeValidation() {
            // Email validation
            document.querySelector('input[name="email"]').addEventListener('blur', function() {
                if (this.value && !isValidEmail(this.value)) {
                    this.classList.add('border-red-500');
                    this.classList.add('focus:ring-red-500');
                } else {
                    this.classList.remove('border-red-500');
                    this.classList.remove('focus:ring-red-500');
                }
            });

            // Phone validation
            document.querySelector('input[name="contactNumber"]').addEventListener('blur', function() {
                if (this.value && !isValidPhoneNumber(this.value)) {
                    this.classList.add('border-red-500');
                    this.classList.add('focus:ring-red-500');
                } else {
                    this.classList.remove('border-red-500');
                    this.classList.remove('focus:ring-red-500');
                }
            });

            // Confirm password match
            document.querySelector('input[name="confirmPassword"]').addEventListener('input', function() {
                const password = document.querySelector('input[name="password"]').value;
                if (this.value && password && this.value !== password) {
                    this.classList.add('border-red-500');
                } else {
                    this.classList.remove('border-red-500');
                }
            });
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            setupRealTimeValidation();
            
            // Prevent form submission if validation fails
            document.querySelector('form').addEventListener('submit', function(e) {
                if (!validateRegistrationForm()) {
                    e.preventDefault();
                }
            });
        });

        // Add animation styles
        const style = document.createElement('style');
        style.textContent = `
            @keyframes fadeIn {
                from { opacity: 0; transform: translateY(-10px); }
                to { opacity: 1; transform: translateY(0); }
            }
            .animate-fadeIn {
                animation: fadeIn 0.3s ease;
            }
        `;
        document.head.appendChild(style);
    </script>

</body>
</html>