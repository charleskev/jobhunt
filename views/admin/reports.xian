<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <title>Reports - Admin</title>
    <style>*{margin:0;padding:0;box-sizing:border-box}body{background:#000;font-family:system-ui;color:#e2e8f0;min-height:100vh;padding-top:60px}.container{max-width:1400px;margin:0 auto;padding:2rem}h1{font-size:2rem;font-weight:700;margin-bottom:0.5rem;color:#fff}.subtitle{color:#94a3b8;font-size:0.95rem;margin-bottom:2rem}.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem}.btn{padding:0.75rem 1.5rem;background:#3b82f6;color:#fff;border:0;border-radius:0.5rem;font-weight:500;cursor:pointer}.btn:hover{background:#2563eb}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;margin-bottom:2rem}.card{background:#111;border:1px solid #222;border-radius:0.75rem;padding:1.5rem}.card-title{font-size:1.1rem;font-weight:600;margin-bottom:1rem;display:flex;justify-content:space-between;align-items:center;color:#fff}.card-stat{display:flex;justify-content:space-between;padding:0.5rem 0;font-size:0.9rem}.card-stat-label{color:#94a3b8}.card-stat-value{font-weight:600;color:#e2e8f0}.table-container{background:#0a0a0a;border:1px solid #222;border-radius:0.75rem;overflow:hidden}table{width:100%;border-collapse:collapse}thead{background:#111;border-bottom:2px solid #222}th{padding:1rem;text-align:left;font-weight:600;color:#cbd5e1;font-size:0.9rem}td{padding:1rem;border-bottom:1px solid #222;font-size:0.9rem;color:#cbd5e1}tr:hover{background:#1a1a1a}.badge{display:inline-block;padding:0.375rem 0.75rem;border-radius:9999px;font-size:0.8rem;font-weight:600}.badge-blue{background:#3b82f644;color:#93c5fd}.badge-green{background:#10b98144;color:#86efac}.badge-purple{background:#8b5cf644;color:#d8b4fe}.link{color:#3b82f6;text-decoration:none;cursor:pointer}.link:hover{text-decoration:underline}h3{color:#fff;margin:1.5rem 0 1rem 0;font-weight:600}</style></head><body>{{> navbar}}<div class="container"><div class="header"><div><h1>📊 Reports</h1><p class="subtitle">System reports and statistics</p></div><button class="btn">⬇️ Export</button></div><div class="grid"><div class="card"><div class="card-title"><span>User Growth</span><span>📈</span></div><div class="card-stat"><span class="card-stat-label">Total Users:</span><span class="card-stat-value">{{stats.totalUsers}}</span></div><div class="card-stat"><span class="card-stat-label">New This Month:</span><span class="card-stat-value" style="color:#16a34a">+{{stats.newThisMonth}}</span></div><div class="card-stat"><span class="card-stat-label">Growth Rate:</span><span class="card-stat-value">{{stats.userGrowthRate}}</span></div></div><div class="card"><div class="card-title"><span>Applications</span><span>📋</span></div><div class="card-stat"><span class="card-stat-label">Total:</span><span class="card-stat-value">{{stats.totalApplications}}</span></div><div class="card-stat"><span class="card-stat-label">Pending:</span><span class="card-stat-value" style="color:#f59e0b">{{stats.pendingApplications}}</span></div><div class="card-stat"><span class="card-stat-label">Completed:</span><span class="card-stat-value" style="color:#16a34a">{{stats.completedApplications}}</span></div></div><div class="card"><div class="card-title"><span>Job Postings</span><span>💼</span></div><div class="card-stat"><span class="card-stat-label">Active:</span><span class="card-stat-value">{{stats.activeJobs}}</span></div><div class="card-stat"><span class="card-stat-label">Closed:</span><span class="card-stat-value">{{stats.closedJobs}}</span></div><div class="card-stat"><span class="card-stat-label">Avg Apps/Job:</span><span class="card-stat-value">{{stats.avgApplicationsPerJob}}</span></div></div><div class="card"><div class="card-title"><span>Conversion Rates</span><span>📊</span></div><div class="card-stat"><span class="card-stat-label">Hire Rate:</span><span class="card-stat-value" style="color:#16a34a">{{stats.hireRate}}%</span></div><div class="card-stat"><span class="card-stat-label">Rejection Rate:</span><span class="card-stat-label">{{stats.rejectionRate}}%</span></div><div class="card-stat"><span class="card-stat-label">Pending Rate:</span><span class="card-stat-value" style="color:#f59e0b">{{#if stats.totalApplications}}{{div (mul stats.pendingApplications 100) stats.totalApplications}}%{{/if}}</span></div></div><div class="card"><div class="card-title"><span>User Breakdown</span><span>👥</span></div><div class="card-stat"><span class="card-stat-label">Applicants:</span><span class="card-stat-value">{{usersByType.applicants}}</span></div><div class="card-stat"><span class="card-stat-label">HR Admins:</span><span class="card-stat-value">{{usersByType.hrAdmins}}</span></div><div class="card-stat"><span class="card-stat-label">Managers:</span><span class="card-stat-value">{{usersByType.managers}}</span></div></div><div class="card"><div class="card-title"><span>Application Status</span><span>📈</span></div><div class="card-stat"><span class="card-stat-label">Submitted:</span><span class="card-stat-value">{{applicationsByStatus.submitted}}</span></div><div class="card-stat"><span class="card-stat-label">Shortlisted:</span><span class="card-stat-value">{{applicationsByStatus.shortlisted}}</span></div><div class="card-stat"><span class="card-stat-label">Hired:</span><span class="card-stat-value" style="color:#16a34a">{{applicationsByStatus.hired}}</span></div></div></div><div class="table-container"><h3 style="padding:1.5rem 1.5rem 0">Top Performing Jobs</h3><table><thead><tr><th>Job Title</th><th>Applications</th><th>Hired</th><th>Conversion Rate</th></tr></thead><tbody>{{#each topJobs}}<tr><td style="font-weight:600">{{this.title}}</td><td>{{this.applications}}</td><td style="color:#16a34a;font-weight:600">{{this.hired}}</td><td><span class="badge badge-blue">{{this.conversionRate}}%</span></td></tr>{{/each}}</tbody></table></div></div>{{> footer}}</body></html>