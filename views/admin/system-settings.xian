<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <title>System Settings</title>
    <style>*{margin:0;padding:0;box-sizing:border-box}body{background:#fff;font-family:system-ui;color:#1e293b}.container{max-width:1000px;margin:0 auto;padding:2rem}h1{font-size:2rem;font-weight:700;margin-bottom:0.5rem}.subtitle{color:#64748b;font-size:0.95rem;margin-bottom:2rem}.section{background:#fff;border:1px solid #e2e8f0;border-radius:0.75rem;padding:1.5rem;margin-bottom:2rem}.section-title{font-size:1.2rem;font-weight:600;margin-bottom:1rem;border-bottom:2px solid #e2e8f0;padding-bottom:0.75rem}.pair{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-bottom:1.5rem}.item label{color:#64748b;font-size:0.9rem;font-weight:500;display:block;margin-bottom:0.5rem}.item input,.item select{width:100%;padding:0.625rem;border:1px solid #e2e8f0;border-radius:0.5rem;font-size:0.9rem}.item input:focus,.item select:focus{outline:0;border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.1)}.buttons{display:flex;gap:1rem;margin-top:2rem}.btn{padding:0.75rem 1.5rem;border:0;border-radius:0.5rem;font-weight:500;cursor:pointer}.btn-primary{background:#3b82f6;color:#fff}.btn-primary:hover{background:#2563eb}.btn-secondary{background:#f1f5f9;color:#1e293b;border:1px solid #e2e8f0}</style></head><body>{{> navbar}}<div class="container"><h1>⚙️ System Settings</h1><p class="subtitle">Configure system-wide settings</p><div class="section"><div class="section-title">General</div><div class="pair"><div class="item"><label>Application Name</label><input type="text" value="HuntJob"></div><div class="item"><label>Support Email</label><input type="text" value="support@huntjob.com"></div></div></div><div class="section"><div class="section-title">🔒 Security</div><div class="pair"><div class="item"><label>Session Timeout (min)</label><input type="number" value="30"></div><div class="item"><label>Max Login Attempts</label><input type="number" value="5"></div></div></div><div class="section"><div class="section-title">📧 Email</div><div class="pair"><div class="item"><label>SMTP Host</label><input type="text" value="smtp.gmail.com"></div><div class="item"><label>SMTP Port</label><input type="number" value="587"></div></div></div><div class="buttons"><button class="btn btn-primary" onclick="alert('Settings saved!')">💾 Save</button><button class="btn btn-secondary" onclick="location.reload()">↻ Reset</button></div></div>{{> footer}}</body></html>