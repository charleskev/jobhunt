<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <title>Users</title>
    <style>*{margin:0;padding:0;box-sizing:border-box}body{background:#000;font-family:system-ui;color:#e2e8f0;min-height:100vh}.container{max-width:1200px;margin:0 auto;padding:2rem}h1{font-size:2.5rem;font-weight:700;margin-bottom:0.5rem;color:#fff}.subtitle{color:#94a3b8;margin-bottom:2rem}.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem}.btn{padding:0.75rem 1.5rem;border:1px solid;border-radius:0.5rem;cursor:pointer;font-weight:600;transition:all 0.3s}.btn-primary{background:#3b82f6;color:#fff;border-color:#3b82f6}.btn-primary:hover{background:#2563eb}.tabs{display:flex;gap:1rem;margin-bottom:1.5rem;border-bottom:1px solid #333;padding-bottom:1rem}.tab-btn{background:none;border:none;color:#94a3b8;font-weight:600;cursor:pointer;padding:0.5rem 1rem;border-bottom:3px solid transparent;transition:all 0.3s}.tab-btn.active{color:#60a5fa;border-bottom-color:#3b82f6}.filter-section{background:#111;border:1px solid #222;border-radius:0.75rem;padding:1.5rem;margin-bottom:1.5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem}.filter-group label{display:block;color:#cbd5e1;font-size:0.9rem;margin-bottom:0.5rem;font-weight:600}.input,.select{width:100%;padding:0.75rem;background:#1a1a1a;border:1px solid #333;border-radius:0.5rem;color:#e2e8f0;font-size:0.9rem}.input:focus,.select:focus{outline:none;border-color:#3b82f6}.table-container{background:#0a0a0a;border:1px solid #222;border-radius:0.75rem;overflow:hidden}table{width:100%;border-collapse:collapse}thead{background:#111}th{padding:1rem;text-align:left;color:#cbd5e1;font-weight:600;border-bottom:1px solid #333}td{padding:1rem;border-bottom:1px solid #222;color:#cbd5e1}tr:hover{background:#1a1a1a}.user-cell{display:flex;align-items:center;gap:0.75rem}.avatar{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.85rem}.badge{display:inline-block;padding:0.375rem 0.75rem;border-radius:0.25rem;font-size:0.8rem;font-weight:600}.badge-active{background:#10b98144;color:#86efac}.badge-inactive{background:#ef444444;color:#fca5a5}.badge-verified{background:#3b82f644;color:#93c5fd}.badge-unverified{background:#64748b44;color:#cbd5e1}.action-link{color:#60a5fa;text-decoration:none;cursor:pointer;margin-right:1rem;font-size:0.9rem}.action-link:hover{color:#3b82f6;text-decoration:underline}</style></head><body>{{> navbar}}<div class="container"><div class="header"><div><h1>👥 Users Management</h1><p class="subtitle">Manage HR managers and applicant accounts</p></div><button class="btn btn-primary" onclick="alert('Redirect to create user')">➕ New User</button></div><div class="tabs"><button class="tab-btn {{#if (eq userType 'hr_admin')}}active{{/if}}" onclick="switchTab('hr')">👔 HR Managers</button><button class="tab-btn {{#if (eq userType 'applicant')}}active{{/if}}" onclick="switchTab('applicants')">👤 Applicants</button></div><div class="filter-section"><div class="filter-group"><label>🔍 Search by Name/Email</label><input type="text" class="input" placeholder="Search users..." id="searchInput"/></div><div class="filter-group"><label>📊 Status</label><select class="select" id="statusFilter"><option value="">All Statuses</option><option value="true">Active</option><option value="false">Inactive</option></select></div><div class="filter-group"><label>✓ Verified</label><select class="select" id="verifiedFilter"><option value="">All Users</option><option value="true">Verified</option><option value="false">Unverified</option></select></div><div style="display:flex;gap:0.5rem;align-items:flex-end"><button class="btn btn-primary" onclick="filterUsers()">🔍 Search</button><button class="btn" style="background:none;border:1px solid #333;color:#94a3b8" onclick="resetUserFilters()">↻ Reset</button></div></div><div class="table-container"><table><thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Verified</th><th>Actions</th></tr></thead><tbody id="userTableBody">{{#each users}}<tr><td><div class="user-cell"><div class="avatar">{{this.firstName.charAt 0}}{{this.lastName.charAt 0}}</div><div><strong>{{this.firstName}} {{this.lastName}}</strong><br/><span style="color:#94a3b8;font-size:0.85rem">{{this.userType}}</span></div></div></td><td>{{this.email}}</td><td><span class="badge {{#if this.isActive}}badge-active{{else}}badge-inactive{{/if}}">{{#if this.isActive}}Active{{else}}Inactive{{/if}}</span></td><td><span class="badge {{#if this.isVerified}}badge-verified{{else}}badge-unverified{{/if}}">{{#if this.isVerified}}✓ Yes{{else}}✗ No{{/if}}</span></td><td><a class="action-link" href="/admin/users/{{this.id}}">View</a><a class="action-link" href="/admin/users/{{this.id}}/edit">Edit</a><a class="action-link" href="#" onclick="toggleUserStatus('{{this.id}}', {{this.isActive}})">{{#if this.isActive}}Deactivate{{else}}Activate{{/if}}</a></td></tr>{{/each}}{{#if (eq users.length 0)}}<tr><td colspan="5" style="text-align:center;padding:2rem;color:#64748b">No users found</td></tr>{{/if}}</tbody></table></div></div>{{> footer}}</body><script>function switchTab(tab){document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));event.target.classList.add('active');let url='/admin/users-list?';if(tab==='hr'){url+='userType=hr_admin'}else if(tab==='applicants'){url+='userType=applicant'}window.location.href=url}function filterUsers(){const search=document.getElementById('searchInput').value;const status=document.getElementById('statusFilter').value;const isVerified=document.getElementById('verifiedFilter').value;const urlParams=new URLSearchParams(window.location.search);const userType=urlParams.get('userType');let url='/admin/users-list?';if(userType)url+='userType='+userType+'&';if(search)url+='search='+encodeURIComponent(search)+'&';if(status)url+='isActive='+status+'&';if(isVerified)url+='isVerified='+isVerified;window.location.href=url}function resetUserFilters(){const urlParams=new URLSearchParams(window.location.search);const userType=urlParams.get('userType');document.getElementById('searchInput').value='';document.getElementById('statusFilter').value='';document.getElementById('verifiedFilter').value='';let url='/admin/users-list?';if(userType)url+='userType='+userType;window.location.href=url}</script></html>