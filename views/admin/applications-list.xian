<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <title>Applications</title>
    <style>*{margin:0;padding:0;box-sizing:border-box}body{background:#000;font-family:system-ui;color:#e2e8f0;min-height:100vh}.container{max-width:1200px;margin:0 auto;padding:2rem}h1{font-size:2.5rem;font-weight:700;margin-bottom:0.5rem;color:#fff}.subtitle{color:#94a3b8;margin-bottom:2rem}.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem}.filter-section{background:#111;border:1px solid #222;border-radius:0.75rem;padding:1.5rem;margin-bottom:1.5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem}.filter-group label{display:block;color:#cbd5e1;font-size:0.9rem;margin-bottom:0.5rem;font-weight:600}.input,.select{width:100%;padding:0.75rem;background:#1a1a1a;border:1px solid #333;border-radius:0.5rem;color:#e2e8f0;font-size:0.9rem}.input:focus,.select:focus{outline:none;border-color:#3b82f6}.btn{padding:0.75rem 1.5rem;border:1px solid;border-radius:0.5rem;cursor:pointer;font-weight:600;background:none;border-color:#333;color:#94a3b8}.btn-primary{background:#3b82f6;color:#fff;border-color:#3b82f6}.table-container{background:#0a0a0a;border:1px solid #222;border-radius:0.75rem;overflow:hidden}table{width:100%;border-collapse:collapse}thead{background:#111}th{padding:1rem;text-align:left;color:#cbd5e1;font-weight:600;border-bottom:1px solid #333}td{padding:1rem;border-bottom:1px solid #222;color:#cbd5e1}tr:hover{background:#1a1a1a}.applicant-cell{display:flex;align-items:center;gap:0.75rem}.avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700}.badge{display:inline-block;padding:0.375rem 0.75rem;border-radius:0.25rem;font-size:0.8rem;font-weight:600}.badge-submitted{background:#60a5fa44;color:#93c5fd}.badge-shortlisted{background:#f59e0b44;color:#fcd34d}.badge-interview{background:#8b5cf644;color:#d8b4fe}.badge-hired{background:#10b98144;color:#86efac}.badge-rejected{background:#ef444444;color:#fca5a5}.action-link{color:#60a5fa;text-decoration:none;cursor:pointer;margin-right:1rem}.action-link:hover{color:#3b82f6}</style></head><body>{{> navbar}}<div class="container"><h1>📋 Applications Management</h1><p class="subtitle">Review and manage job applications</p><div class="filter-section"><div class="filter-group"><label>🔍 Search Applicant/Job</label><input type="text" class="input" placeholder="Search..." id="searchInput"/></div><div class="filter-group"><label>📊 Status</label><select class="select" id="statusFilter"><option value="">All Status</option><option value="submitted">Submitted</option><option value="shortlisted">Shortlisted</option><option value="interview">Interview</option><option value="hired">Hired</option><option value="rejected">Rejected</option></select></div><div style="display:flex;gap:0.5rem;align-items:flex-end"><button class="btn btn-primary" onclick="filterApplications()">🔍 Search</button><button class="btn" style="background:none;border:1px solid #333;color:#94a3b8" onclick="resetAppFilters()">↻ Reset</button></div></div><div class="table-container"><table><thead><tr><th>Applicant</th><th>Job Title</th><th>Status</th><th>Applied Date</th><th>Actions</th></tr></thead><tbody>{{#each applications}}<tr><td><div class="applicant-cell"><div class="avatar">{{this.applicant.firstName.charAt 0}}{{this.applicant.lastName.charAt 0}}</div><div><strong>{{this.applicant.firstName}} {{this.applicant.lastName}}</strong><br/><span style="color:#94a3b8;font-size:0.85rem">{{this.applicant.email}}</span></div></div></td><td>{{#if this.job}}{{this.job.title}}{{else}}N/A{{/if}}</td><td><span class="badge badge-{{this.status}}">{{this.status}}</span></td><td>{{#if this.createdAt}}{{format this.createdAt 'MMM DD, YYYY'}}{{else}}N/A{{/if}}</td><td><a class="action-link" href="/admin/applications/{{this.id}}/review">Review</a><a class="action-link" href="#">Profile</a></td></tr>{{/each}}{{#if (eq applications.length 0)}}<tr><td colspan="5" style="text-align:center;padding:2rem;color:#64748b">No applications found</td></tr>{{/if}}</tbody></table></div></div>{{> footer}}</body><script>function filterApplications(){const search=document.getElementById('searchInput').value;const status=document.getElementById('statusFilter').value;let url='/admin/applications?';if(search)url+='search='+encodeURIComponent(search)+'&';if(status)url+='status='+status;window.location.href=url}function resetAppFilters(){document.getElementById('searchInput').value='';document.getElementById('statusFilter').value='';window.location.href='/admin/applications'}</script></html>