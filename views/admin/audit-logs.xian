<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <title>Audit Logs</title>
    <style>*{margin:0;padding:0;box-sizing:border-box}body{background:#000;font-family:system-ui;color:#e2e8f0;min-height:100vh;padding-top:60px}.container{max-width:1200px;margin:0 auto;padding:2rem}h1{font-size:2.5rem;font-weight:700;margin-bottom:0.5rem;color:#fff}.subtitle{color:#94a3b8;margin-bottom:2rem}.filter-section{background:#111;border:1px solid #222;border-radius:0.75rem;padding:1.5rem;margin-bottom:1.5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem}.filter-group label{display:block;color:#cbd5e1;font-size:0.9rem;margin-bottom:0.5rem;font-weight:600}.input,.select{width:100%;padding:0.75rem;background:#1a1a1a;border:1px solid #333;border-radius:0.5rem;color:#e2e8f0;font-size:0.9rem}.input:focus,.select:focus{outline:none;border-color:#3b82f6}.btn{padding:0.75rem 1.5rem;border:1px solid;border-radius:0.5rem;cursor:pointer;font-weight:600;background:none;border-color:#333;color:#94a3b8}.btn-primary{background:#3b82f6;color:#fff;border-color:#3b82f6}.table-container{background:#0a0a0a;border:1px solid #222;border-radius:0.75rem;overflow:hidden}table{width:100%;border-collapse:collapse}thead{background:#111}th{padding:1rem;text-align:left;color:#cbd5e1;font-weight:600;border-bottom:1px solid #333}td{padding:0.75rem 1rem;border-bottom:1px solid #222;color:#cbd5e1;font-size:0.9rem}tr:hover{background:#1a1a1a}.badge{display:inline-block;padding:0.375rem 0.75rem;border-radius:0.25rem;font-size:0.75rem;font-weight:600}.badge-login{background:#3b82f644;color:#93c5fd}.badge-create{background:#10b98144;color:#86efac}.badge-update{background:#f59e0b44;color:#fcd34d}.badge-delete{background:#ef444444;color:#fca5a5}</style></head><body>{{> navbar}}<div class="container"><h1>📊 Audit Logs</h1><p class="subtitle">System activity and change tracking</p><div class="filter-section"><div class="filter-group"><label>🔍 Search</label><input type="text" class="input" placeholder="Search logs..." id="searchInput"/></div><div class="filter-group"><label>🏷️ Action Type</label><select class="select" id="actionFilter"><option value="">All Actions</option><option value="login">Login</option><option value="create">Create</option><option value="update">Update</option><option value="delete">Delete</option></select></div><div class="filter-group"><label>👤 User</label><select class="select" id="userFilter"><option value="">All Users</option><option value="admin">Admin Juan</option><option value="hr">HR Maria</option></select></div><div style="display:flex;gap:0.5rem;align-items:flex-end"><button class="btn btn-primary" onclick="filterLogs()">🔍 Filter</button><button class="btn" style="background:none;border:1px solid #333;color:#94a3b8" onclick="resetLogFilters()">↻ Reset</button><button class="btn" onclick="alert('Exporting CSV...')">📥 CSV</button><button class="btn" onclick="alert('Exporting PDF...')">📄 PDF</button></div></div><div class="table-container"><table><thead><tr><th>Timestamp</th><th>User</th><th>Action</th><th>Entity Type</th><th>Description</th><th>IP Address</th></tr></thead><tbody>{{#each logs}}<tr><td>{{#if this.createdAt}}{{format this.createdAt 'MMM DD, YYYY HH:mm A'}}{{else}}N/A{{/if}}</td><td>{{#if this.user}}{{this.user.firstName}} {{this.user.lastName}}{{else}}System{{/if}}</td><td><span class="badge badge-{{this.action}}">{{this.action}}</span></td><td>{{this.entityType}}</td><td>{{this.description}}</td><td>{{this.ipAddress}}</td></tr>{{/each}}{{#if (eq logs.length 0)}}<tr><td colspan="6" style="text-align:center;padding:2rem;color:#64748b">No audit logs found</td></tr>{{/if}}</tbody></table></div></div>{{> footer}}</body><script>function filterLogs(){const search=document.getElementById('searchInput').value;const action=document.getElementById('actionFilter').value;const user=document.getElementById('userFilter').value;let url='/admin/audit-logs?';if(search)url+='search='+encodeURIComponent(search)+'&';if(action)url+='action='+action+'&';if(user)url+='user='+user;window.location.href=url}function resetLogFilters(){document.getElementById('searchInput').value='';document.getElementById('actionFilter').value='';document.getElementById('userFilter').value='';window.location.href='/admin/audit-logs'}</script></html>