<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <title>Admin Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            font-family: system-ui;
            color: #e2e8f0;
            min-height: 100vh;
            padding-top: 60px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }
        h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: #fff;
        }
        .subtitle {
            color: #94a3b8;
            margin-bottom: 2rem;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        .stat-card {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid #334155;
            border-radius: 0.75rem;
            padding: 1.5rem;
            transition: all 0.3s;
        }
        .stat-card:hover {
            border-color: #475569;
            transform: translateY(-2px);
        }
        .stat-label {
            color: #94a3b8;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }
        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
        }
        .stat-change {
            color: #10b981;
            font-size: 0.85rem;
            margin-top: 0.5rem;
        }
        .section {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid #334155;
            border-radius: 0.75rem;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }
        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #fff;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #334155;
            padding-bottom: 0.75rem;
        }
        .action-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }
        .action-link {
            background: #3b82f6;
            color: #fff;
            padding: 1rem;
            border-radius: 0.5rem;
            text-align: center;
            text-decoration: none;
            transition: all 0.3s;
            border: 2px solid #3b82f6;
        }
        .action-link:hover {
            background: transparent;
            color: #3b82f6;
        }
        .btn {
            padding: 0.75rem 1.5rem;
            border: 1px solid;
            border-radius: 0.5rem;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.3s;
        }
        .btn-primary {
            background: #3b82f6;
            color: #fff;
            border-color: #3b82f6;
        }
        .btn-primary:hover {
            background: #2563eb;
            border-color: #2563eb;
        }
        .activity-item {
            padding: 1rem;
            border-left: 4px solid #3b82f6;
            background: rgba(59, 130, 246, 0.1);
            border-radius: 0.25rem;
            margin-bottom: 0.75rem;
        }
        .activity-time {
            color: #94a3b8;
            font-size: 0.85rem;
        }
        .activity-text {
            color: #e2e8f0;
            font-weight: 500;
            margin: 0.25rem 0;
        }
        .status-good {
            color: #10b981;
        }
        .status-warning {
            color: #f59e0b;
        }
        .status-bad {
            color: #ef4444;
        }
        .badge {
            display: inline-block;
            padding: 0.375rem 0.75rem;
            border-radius: 0.25rem;
            font-size: 0.8rem;
            font-weight: 600;
            background: rgba(59, 130, 246, 0.2);
            color: #60a5fa;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        thead {
            background: rgba(59, 130, 246, 0.1);
        }
        th {
            padding: 1rem;
            text-align: left;
            color: #cbd5e1;
            font-weight: 600;
            border-bottom: 2px solid #334155;
        }
        td {
            padding: 1rem;
            border-bottom: 1px solid #334155;
            color: #cbd5e1;
        }
        tr:hover {
            background: rgba(59, 130, 246, 0.05);
        }
    </style>
</head>
<body>
    
    <div style="min-height: calc(100vh - 60px);">
        <div class="container">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">👥 Total Users</div>
                <div class="stat-value">1,247</div>
                <div class="stat-change">↑ 12% from last month</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">💼 Job Postings</div>
                <div class="stat-value">42</div>
                <div class="stat-change">↑ 5 new this week</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">📋 Applications</div>
                <div class="stat-value">523</div>
                <div class="stat-change">↑ 23% conversion rate</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">👔 HR Managers</div>
                <div class="stat-value">8</div>
                <div class="stat-change">2 active today</div>
            </div>
        </div>
        
        <div class="section">
            <div class="section-title">🚀 Quick Actions</div>
            <div class="action-grid">
                <a href="/admin/users-list" class="action-link">👥 Manage Users</a>
                <a href="/admin/jobs-list" class="action-link">💼 Manage Jobs</a>
                <a href="/admin/applications-list" class="action-link">📋 Applications</a>
                <a href="/admin/audit-logs" class="action-link">📊 Audit Logs</a>
                <a href="/admin/create-user" class="action-link">➕ Create User</a>
                <a href="/admin/system-settings" class="action-link">⚙️ Settings</a>
            </div>
        </div>
        
        <div class="section">
            <div class="section-title">📊 Recent Activity</div>
            <table>
                <tbody>
                    <tr>
                        <td><span class="badge">Login</span> Admin Juan logged in</td>
                        <td style="text-align:right;color:#94a3b8">5 min ago</td>
                    </tr>
                    <tr>
                        <td><span class="badge">Create</span> New job "Senior Developer" posted</td>
                        <td style="text-align:right;color:#94a3b8">1 hour ago</td>
                    </tr>
                    <tr>
                        <td><span class="badge">Update</span> Application status changed to "Hired"</td>
                        <td style="text-align:right;color:#94a3b8">3 hours ago</td>
                    </tr>
                    <tr>
                        <td><span class="badge">Create</span> HR Manager Maria created new user</td>
                        <td style="text-align:right;color:#94a3b8">Yesterday</td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <div class="section">
            <div class="section-title">🔧 System Status</div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem">
                <div class="stat-card">
                    <div class="stat-label">Database</div>
                    <div style="color:#10b981;font-weight:700">● Online</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Server</div>
                    <div style="color:#10b981;font-weight:700">● Online</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">API</div>
                    <div style="color:#10b981;font-weight:700">● Online</div>
                </div>
            </div>
        </div>
    </div>
    
    {{> footer}}
</body>
</html>