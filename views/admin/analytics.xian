<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <title>Analytics</title>
    <style>*{margin:0;padding:0;box-sizing:border-box}body{background:#000;font-family:system-ui;color:#e2e8f0;min-height:100vh;padding-top:60px}.container{max-width:1400px;margin:0 auto;padding:2rem}h1{font-size:2rem;font-weight:700;margin-bottom:0.5rem;color:#fff}.subtitle{color:#94a3b8;margin-bottom:2rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.5rem;margin-bottom:2rem}.stat-card{background:#111;border:1px solid #222;border-radius:0.75rem;padding:1.5rem}.stat-title{color:#94a3b8;font-size:0.9rem;margin-bottom:0.75rem}.stat-value{font-size:2rem;font-weight:700;color:#fff;margin-bottom:0.5rem}.stat-change{font-size:0.9rem;color:#10b981}.table-container{background:#0a0a0a;border:1px solid #222;border-radius:0.75rem;overflow:hidden;margin-bottom:2rem}table{width:100%;border-collapse:collapse}thead{background:#111;border-bottom:2px solid #222}th,td{padding:1rem;text-align:left;border-bottom:1px solid #222;font-size:0.9rem;color:#cbd5e1}th{font-weight:600}tr:hover{background:#1a1a1a}h3{font-size:1.25rem;margin:1.5rem 0 1rem 0;font-weight:600;color:#fff}</style></head><body>{{> navbar}}<div class="container"><h1>📊 Analytics</h1><p class="subtitle">System analytics and metrics</p><div class="grid"><div class="stat-card"><div class="stat-title">Total Users</div><div class="stat-value">{{stats.totalUsers}}</div><div class="stat-change">↑ {{stats.userGrowthRate}} from last month</div></div><div class="stat-card"><div class="stat-title">Page Views</div><div class="stat-value">{{stats.pageViews}}</div><div class="stat-change">Avg 2.5 per application</div></div><div class="stat-card"><div class="stat-title">Total Applications</div><div class="stat-value">{{stats.totalApplications}}</div><div class="stat-change">↑ {{stats.applicationGrowthRate}} from last month</div></div><div class="stat-card"><div class="stat-title">Bounce Rate</div><div class="stat-value">{{stats.bounceRate}}</div><div class="stat-change">Avg session: {{stats.avgSessionDuration}}</div></div></div><h3>📈 Key Metrics</h3><div class="table-container"><table><thead><tr><th>Metric</th><th>Value</th><th>Percentage</th></tr></thead><tbody><tr><td>Unique Applicants</td><td>{{stats.uniqueUsers}}</td><td>{{#if stats.totalUsers}}{{div (mul stats.uniqueUsers 100) stats.totalUsers}}%{{/if}}</td></tr><tr><td>Active Job Postings</td><td>{{stats.activeJobs}}</td><td>{{#if stats.totalJobs}}{{div (mul stats.activeJobs 100) stats.totalJobs}}%{{/if}}</td></tr><tr><td>Bounce Rate</td><td>{{stats.bounceRate}}</td><td>Avg engagement rate</td></tr><tr><td>Avg Session Duration</td><td>{{stats.avgSessionDuration}}</td><td>Per user session</td></tr></tbody></table></div><h3>👥 User Type Distribution</h3><div class="table-container"><table><thead><tr><th>User Type</th><th>Count</th><th>Percentage</th></tr></thead><tbody>{{#each usersByType}}<tr><td>{{this.type}}</td><td>{{this.count}}</td><td>{{this.percentage}}%</td></tr>{{/each}}</tbody></table></div><h3>📋 Application Status Distribution</h3><div class="table-container"><table><thead><tr><th>Status</th><th>Count</th><th>Percentage</th></tr></thead><tbody>{{#each statusDistribution}}<tr><td>{{this.status}}</td><td>{{this.count}}</td><td>{{this.percentage}}%</td></tr>{{/each}}</tbody></table></div><h3>🌐 Top Pages</h3><div class="table-container"><table><thead><tr><th>Page</th><th>Views</th><th>Users</th><th>Avg Duration</th><th>Bounce Rate</th></tr></thead><tbody>{{#each topPages}}<tr><td style="font-weight:600">{{this.page}}</td><td>{{this.views}}</td><td>{{this.users}}</td><td>{{this.duration}}</td><td>{{this.bounce}}</td></tr>{{/each}}</tbody></table></div></div>{{> footer}}</body></html>