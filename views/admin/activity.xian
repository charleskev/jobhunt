<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <title>Activity</title>
    <style>*{margin:0;padding:0;box-sizing:border-box}body{background:#000;font-family:system-ui;color:#e2e8f0;min-height:100vh;padding-top:60px}.container{max-width:1200px;margin:0 auto;padding:2rem}h1{font-size:2rem;font-weight:700;margin-bottom:0.5rem;color:#fff}.subtitle{color:#94a3b8;margin-bottom:2rem}.filters{background:#111;border:1px solid #222;border-radius:0.75rem;padding:1.5rem;margin-bottom:2rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem}.filter-item label{color:#cbd5e1;font-size:0.9rem;font-weight:500;display:block;margin-bottom:0.5rem}.filter-item input,.filter-item select{width:100%;padding:0.625rem;background:#1a1a1a;border:1px solid #333;border-radius:0.5rem;color:#e2e8f0}.activity-list{background:#0a0a0a;border:1px solid #222;border-radius:0.75rem;overflow:hidden}.activity-item{display:flex;gap:1rem;padding:1.5rem;border-bottom:1px solid #222;align-items:start}.activity-icon{width:40px;height:40px;background:#1a1a1a;border:1px solid #333;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0}.activity-content{flex:1}.activity-title{font-weight:600;color:#fff;margin-bottom:0.25rem}.activity-description{color:#94a3b8;font-size:0.9rem;margin-bottom:0.5rem}.activity-timestamp{color:#64748b;font-size:0.85rem}.badge{display:inline-block;padding:0.25rem 0.5rem;background:#1a1a1a;color:#cbd5e1;border:1px solid #333;border-radius:0.25rem;font-size:0.8rem}</style></head><body>{{> navbar}}<div class="container"><h1>📊 System Activity</h1><p class="subtitle">Recent system and user activities</p><div class="filters"><div class="filter-item"><label>Filter by Type</label><select><option>All Types</option><option>Login</option><option>Create</option><option>Update</option><option>Delete</option></select></div><div class="filter-item"><label>Filter by User</label><select><option>All Users</option><option>Admin</option><option>HR Managers</option><option>System</option></select></div><div class="filter-item"><label>Date Range</label><input type="date"></div></div><div class="activity-list"><div class="activity-item"><div class="activity-icon">📝</div><div class="activity-content"><div class="activity-title">HR Manager Login</div><div class="activity-description">HR 2.0 One logged in to the system</div><div class="activity-timestamp">Just now · <span class="badge">Login</span></div></div></div><div class="activity-item"><div class="activity-icon">✏️</div><div class="activity-content"><div class="activity-title">Job Created</div><div class="activity-description">Software Engineer position created by admin</div><div class="activity-timestamp">5 minutes ago · <span class="badge">Create</span></div></div></div><div class="activity-item"><div class="activity-icon">🔄</div><div class="activity-content"><div class="activity-title">Application Updated</div><div class="activity-description">Application status changed to Hired</div><div class="activity-timestamp">12 minutes ago · <span class="badge">Update</span></div></div></div><div class="activity-item"><div class="activity-icon">👤</div><div class="activity-content"><div class="activity-title">User Created</div><div class="activity-description">New HR Manager account created</div><div class="activity-timestamp">1 hour ago · <span class="badge">Create</span></div></div></div><div class="activity-item"><div class="activity-icon">📊</div><div class="activity-content"><div class="activity-title">Database Backup</div><div class="activity-description">Automatic system backup completed successfully</div><div class="activity-timestamp">2 hours ago · <span class="badge">System</span></div></div></div></div></div>{{> footer}}</body></html>