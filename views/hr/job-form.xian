<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <title>Create Municipality Job - HR - HuntJob</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .form-section { background: #f9fafb; padding: 1.5rem; border-radius: 0.75rem; margin-bottom: 2rem; }
        .form-label { font-weight: 600; font-size: 0.875rem; margin-bottom: 0.5rem; }
        .form-input, .form-select, .form-textarea { 
            width: 100%; 
            padding: 0.75rem; 
            border: 1px solid #d1d5db; 
            border-radius: 0.5rem;
            font-family: inherit;
        }
        .form-input:focus, .form-select:focus, .form-textarea:focus {
            outline: none;
            ring: 2px;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }
        .required::after { content: " *"; color: #ef4444; }
    </style>
</head>
<body class="bg-gray-50 pt-[60px]">
    {{> navbar}}
    
    <div class="flex h-[calc(100vh-60px)]">
        {{> sidebar-hr}}
        
        <div class="flex-1 overflow-y-auto flex flex-col">
            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-600 to-blue-700 text-white py-8 px-6 flex-shrink-0">
                <div class="max-w-4xl mx-auto">
                    <h1 class="text-4xl font-bold mb-2">{{#if job}}Edit Municipality Job{{else}}Create Municipality Job{{/if}}</h1>
                    <p class="text-blue-100">{{#if job}}Update{{else}}Post a new job for{{/if}} municipality level positions</p>
                </div>
            </div>

            <!-- Form Container -->
            <div class="flex-1 overflow-y-auto">
                <div class="max-w-4xl mx-auto px-4 py-8">
                    <form method="POST" action="/api/manager/jobs" class="bg-white rounded-xl shadow-lg overflow-hidden">
                        {{#if job}}<input type="hidden" name="_method" value="PUT">{{/if}}
                        {{#if job}}<input type="hidden" name="jobId" value="{{job.id}}">{{/if}}
                    
                    <!-- Basic Information Section -->
                    <div class="p-8">
                        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                            <i class="fas fa-briefcase text-blue-600 mr-3"></i>
                            Basic Information
                        </h2>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <div>
                                <label class="block form-label text-gray-700">Job Title <span class="required"></span></label>
                                <input type="text" name="title" value="{{job.title}}" required placeholder="e.g., Administrative Officer" class="form-input">
                            </div>
                            <div>
                                <label class="block form-label text-gray-700">Job Type <span class="required"></span></label>
                                <select name="jobType" required class="form-select">
                                    <option value="">Select Type</option>
                                    <option value="full-time" {{#if (eq job.jobType 'full-time')}}selected{{/if}}>Full-time</option>
                                    <option value="part-time" {{#if (eq job.jobType 'part-time')}}selected{{/if}}>Part-time</option>
                                    <option value="contract" {{#if (eq job.jobType 'contract')}}selected{{/if}}>Contract</option>
                                    <option value="internship" {{#if (eq job.jobType 'internship')}}selected{{/if}}>Internship</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <div>
                                <label class="block form-label text-gray-700">Category</label>
                                <input type="text" name="category" value="{{job.category}}" placeholder="e.g., Administration, IT, etc." class="form-input">
                            </div>
                            <div>
                                <label class="block form-label text-gray-700">Location <span class="required"></span></label>
                                <input type="text" name="location" value="{{job.location}}" required placeholder="e.g., City Hall" class="form-input">
                            </div>
                        </div>

                        <div>
                            <label class="flex items-center">
                                <input type="checkbox" name="isRemote" value="true" {{#if job.isRemote}}checked{{/if}} class="rounded">
                                <span class="ml-3 text-sm font-medium text-gray-700">Remote Position</span>
                            </label>
                        </div>
                    </div>

                    <!-- Description Section -->
                    <div class="border-t border-gray-200 p-8">
                        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                            <i class="fas fa-align-left text-blue-600 mr-3"></i>
                            Job Details
                        </h2>

                        <div class="mb-6">
                            <label class="block form-label text-gray-700">Description <span class="required"></span></label>
                            <textarea name="description" required rows="6" placeholder="Describe the job responsibilities and duties" class="form-textarea">{{job.description}}</textarea>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div>
                                <label class="block form-label text-gray-700">Salary Min</label>
                                <input type="number" name="salaryMin" value="{{job.salaryMin}}" placeholder="0" class="form-input">
                            </div>
                            <div>
                                <label class="block form-label text-gray-700">Salary Max</label>
                                <input type="number" name="salaryMax" value="{{job.salaryMax}}" placeholder="0" class="form-input">
                            </div>
                            <div>
                                <label class="block form-label text-gray-700">Salary Type</label>
                                <select name="salaryType" class="form-select">
                                    <option value="monthly" {{#if (eq job.salaryType 'monthly')}}selected{{/if}}>Monthly</option>
                                    <option value="hourly" {{#if (eq job.salaryType 'hourly')}}selected{{/if}}>Hourly</option>
                                    <option value="yearly" {{#if (eq job.salaryType 'yearly')}}selected{{/if}}>Yearly</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Requirements Section -->
                    <div class="border-t border-gray-200 p-8">
                        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                            <i class="fas fa-check-circle text-blue-600 mr-3"></i>
                            Requirements
                        </h2>

                        <div class="mb-6">
                            <label class="block form-label text-gray-700">Required Skills</label>
                            <input type="text" name="skills" placeholder="Separate with commas" value="{{job.skills}}" class="form-input">
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block form-label text-gray-700">Experience Level</label>
                                <select name="experience" class="form-select">
                                    <option value="">Select</option>
                                    <option value="entry" {{#if (eq job.experience 'entry')}}selected{{/if}}>Entry Level</option>
                                    <option value="mid" {{#if (eq job.experience 'mid')}}selected{{/if}}>Mid Level</option>
                                    <option value="senior" {{#if (eq job.experience 'senior')}}selected{{/if}}>Senior Level</option>
                                </select>
                            </div>
                            <div>
                                <label class="block form-label text-gray-700">Education Level</label>
                                <select name="education" class="form-select">
                                    <option value="">Select</option>
                                    <option value="high-school" {{#if (eq job.education 'high-school')}}selected{{/if}}>High School</option>
                                    <option value="bachelor" {{#if (eq job.education 'bachelor')}}selected{{/if}}>Bachelor's Degree</option>
                                    <option value="master" {{#if (eq job.education 'master')}}selected{{/if}}>Master's Degree</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="border-t border-gray-200 px-8 py-6 bg-gray-50 flex gap-4">
                        <button type="submit" class="flex-1 px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white font-bold rounded-lg hover:shadow-lg transition">
                            <i class="fas fa-save mr-2"></i>
                            {{#if job}}Update Job{{else}}Create Job{{/if}}
                        </button>
                        <a href="/hr/jobs-list" class="flex-1 px-6 py-3 bg-gray-300 text-gray-800 font-bold rounded-lg hover:bg-gray-400 transition text-center">
                            <i class="fas fa-times mr-2"></i>
                            Cancel
                        </a>
                    </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {{> footer}}
</body>
</html>
                <option value="senior" {{#if (eq job.experience 'senior')}}selected{{/if}}>Senior Level</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">Education</label>
              <input type="text" name="education" value="{{job.education}}" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
          </div>

          <!-- Deadline -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-slate-700 mb-2">Application Deadline</label>
            <input type="datetime-local" name="deadline" value="{{job.deadline}}" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>

          <!-- Buttons -->
          <div class="flex gap-4">
            <button type="submit" class="flex-1 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium">
              {{#if job}}Update Job{{else}}Post Job{{/if}}
            </button>
            <a href="/hr/jobs-list" class="flex-1 text-center px-6 py-3 bg-slate-200 text-slate-900 rounded-lg hover:bg-slate-300 transition font-medium">
              Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
{{> footer}}
</body>
</html>
