<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <title>Notifications - HR</title>
    <style>
        .gradient-bg { background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%); }
        .notification-card { transition: all 0.3s ease; }
        .notification-card:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1); }
        .unread-indicator { animation: pulse 2s infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    </style>
</head>
<body class="bg-gray-50 pt-[60px]">
<div class="flex h-[calc(100vh-60px)]">
    {{> sidebar-hr}}
    <div class="flex-1 overflow-y-auto">
        <!-- Gradient Header -->
        <div class="gradient-bg text-white py-8 px-4">
            <div class="max-w-6xl mx-auto flex justify-between items-center">
                <div>
                    <h1 class="text-4xl font-black mb-1">Notifications</h1>
                    <p class="text-blue-100">Stay updated with recruitment activity</p>
                </div>
                <div class="flex gap-3">
                    <button onclick="markAllRead()" class="px-4 py-2 bg-white hover:bg-gray-100 text-blue-600 rounded-lg font-semibold transition text-sm">
                        <i class="fas fa-check-double mr-2"></i>Mark All Read
                    </button>
                    <button onclick="deleteAll()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-semibold transition text-sm">
                        <i class="fas fa-trash mr-2"></i>Clear All
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="max-w-6xl mx-auto px-4 py-8">
            <!-- Filter Tabs -->
            <div class="flex gap-2 mb-8 overflow-x-auto pb-2">
                <button class="px-4 py-2 bg-blue-600 text-white rounded-lg font-semibold text-sm transition hover:bg-blue-700">
                    <i class="fas fa-bell mr-2"></i>All
                </button>
                <button class="px-4 py-2 bg-white border border-gray-300 text-gray-900 rounded-lg font-semibold text-sm transition hover:bg-gray-50">
                    <i class="fas fa-file-alt mr-2"></i>Applications
                </button>
                <button class="px-4 py-2 bg-white border border-gray-300 text-gray-900 rounded-lg font-semibold text-sm transition hover:bg-gray-50">
                    <i class="fas fa-briefcase mr-2"></i>Jobs
                </button>
                <button class="px-4 py-2 bg-white border border-gray-300 text-gray-900 rounded-lg font-semibold text-sm transition hover:bg-gray-50">
                    <i class="fas fa-calendar-alt mr-2"></i>Interviews
                </button>
                <button class="px-4 py-2 bg-white border border-gray-300 text-gray-900 rounded-lg font-semibold text-sm transition hover:bg-gray-50">
                    <i class="fas fa-cog mr-2"></i>System
                </button>
            </div>

            <!-- Notifications List -->
            {{#if notifications}}
            <div class="space-y-4">
                {{#each notifications}}
                <div class="notification-card bg-white rounded-2xl shadow-md p-6 {{#unless isRead}}border-l-4 border-blue-600{{/unless}}">
                    <div class="flex justify-between items-start gap-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-2">
                                <h3 class="text-lg font-bold text-gray-900">{{title}}</h3>
                                {{#unless isRead}}
                                <span class="unread-indicator w-3 h-3 bg-blue-600 rounded-full"></span>
                                {{/unless}}
                            </div>
                            <p class="text-gray-700 text-sm mb-4">{{message}}</p>

                            <div class="flex items-center justify-between">
                                <p class="text-xs text-gray-600">
                                    <i class="fas fa-clock mr-1"></i>
                                    {{createdAt}}
                                </p>
                                {{#if relatedId}}
                                <a href="/hr/{{relatedType}}/{{relatedId}}" class="text-blue-600 hover:text-blue-700 font-semibold text-sm transition">
                                    <i class="fas fa-arrow-right mr-1"></i>View Details
                                </a>
                                {{/if}}
                            </div>
                        </div>

                        <div class="flex gap-2">
                            {{#unless isRead}}
                            <button onclick="markAsRead('{{id}}')" class="px-3 py-1 text-xs font-semibold bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 transition">
                                <i class="fas fa-check mr-1"></i>Mark Read
                            </button>
                            {{/unless}}
                            <button onclick="deleteNotification('{{id}}')" class="px-3 py-1 text-xs font-semibold bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition">
                                <i class="fas fa-trash mr-1"></i>Delete
                            </button>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <!-- Empty State -->
            <div class="bg-white rounded-2xl shadow-md p-12 text-center">
                <i class="fas fa-bell text-6xl text-gray-300 mb-4"></i>
                <h3 class="text-2xl font-bold text-gray-900 mb-2">No Notifications</h3>
                <p class="text-gray-600">You're all caught up! Check back soon for updates</p>
            </div>
            {{/if}}
        </div>

        {{> footer}}
    </div>
</div>

<script>
    function markAsRead(notificationId) {
        fetch(`/hr/notifications/${notificationId}/read`, { method: 'PUT' })
            .then(() => location.reload())
            .catch(e => console.error(e));
    }

    function markAllRead() {
        fetch('/hr/notifications/read-all', { method: 'PUT' })
            .then(() => location.reload())
            .catch(e => console.error(e));
    }

    function deleteNotification(notificationId) {
        if (confirm('Delete this notification?')) {
            fetch(`/hr/notifications/${notificationId}`, { method: 'DELETE' })
                .then(() => location.reload())
                .catch(e => console.error(e));
        }
    }

    function deleteAll() {
        if (confirm('Delete all notifications?')) {
            fetch('/hr/notifications', { method: 'DELETE' })
                .then(() => location.reload())
                .catch(e => console.error(e));
        }
    }
</script>
</body>
</html>
