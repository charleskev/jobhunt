<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <title>Jobs List - HR - HuntJob</title>
</head>
<body style="padding-top: 60px">
{{> navbar}}
<div class="flex h-[calc(100vh-60px)]">
  {{> sidebar-hr}}
  
  <div class="flex-1 overflow-y-auto">
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
      <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
          <div>
            <h1 class="text-4xl font-bold text-slate-900 mb-2">Job Listings</h1>
            <p class="text-slate-600">Manage all your job openings</p>
          </div>
          <a href="/hr/job-form" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium">
            + Post New Job
          </a>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">Status</label>
              <select class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">All</option>
                <option value="active">Active</option>
                <option value="closed">Closed</option>
                <option value="draft">Draft</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">Sort By</label>
              <select class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="recent">Most Recent</option>
                <option value="applications">Most Applications</option>
              </select>
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-slate-700 mb-2">Search</label>
              <input type="text" placeholder="Search jobs..." class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
          </div>
        </div>

        <!-- Jobs Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <table class="w-full">
            <thead class="bg-slate-50 border-b border-slate-200">
              <tr>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Job Title</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Location</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Applications</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Status</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Posted</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              {{#each jobs}}
              <tr class="hover:bg-slate-50 transition">
                <td class="px-6 py-4">
                  <h3 class="font-semibold text-slate-900">{{this.title}}</h3>
                </td>
                <td class="px-6 py-4 text-slate-600">{{this.location}}</td>
                <td class="px-6 py-4">
                  <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full font-medium">
                    {{this.applicationsCount}}
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class="px-3 py-1 rounded-full font-medium {{#if this.isActive}}bg-green-100 text-green-800{{else}}bg-slate-100 text-slate-800{{/if}}">
                    {{#if this.isActive}}Active{{else}}Closed{{/if}}
                  </span>
                </td>
                <td class="px-6 py-4 text-slate-600">{{this.createdAt}}</td>
                <td class="px-6 py-4">
                  <div class="flex gap-2">
                    <a href="/hr/jobs/{{this.id}}/applications" class="text-blue-600 hover:text-blue-700 font-medium">View</a>
                    <a href="/hr/job-form?id={{this.id}}" class="text-slate-600 hover:text-slate-700 font-medium">Edit</a>
                    <button onclick="deleteJob({{this.id}})" class="text-red-600 hover:text-red-700 font-medium">Delete</button>
                  </div>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <script>
      function deleteJob(jobId) {
        if (confirm('Are you sure you want to delete this job?')) {
          fetch(`/api/manager/jobs/${jobId}`, { method: 'DELETE' })
            .then(() => location.reload());
        }
      }
    </script>
      </div>
    </div>
  </div>
</div>
{{> footer}}
</body>
</html>


