<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <title>Manage Users - HR - HuntJob</title>
</head>
<body style="padding-top: 60px">
{{> navbar}}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100" style="margin-top: 0">
      <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
          <h1 class="text-4xl font-bold text-slate-900 mb-2">Manage Users</h1>
          <p class="text-slate-600">View and manage system users (Admin only)</p>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">User Type</label>
              <select class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">All Types</option>
                <option value="jobseeker">Job Seeker</option>
                <option value="employer">Employer</option>
                <option value="admin">Admin</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">Status</label>
              <select class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">All</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
              </select>
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-slate-700 mb-2">Search</label>
              <input type="text" placeholder="Search by name or email" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
          </div>
        </div>

        <!-- Users Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <table class="w-full">
            <thead class="bg-slate-50 border-b border-slate-200">
              <tr>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Name</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Email</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Type</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Status</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Verified</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Joined</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-slate-900">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              {{#each users}}
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4">
                  <h3 class="font-semibold text-slate-900">{{this.firstName}} {{this.lastName}}</h3>
                </td>
                <td class="px-6 py-4 text-slate-600">{{this.email}}</td>
                <td class="px-6 py-4">
                  <span class="px-3 py-1 rounded-full text-sm font-medium {{#if (eq this.userType 'jobseeker')}}bg-blue-100 text-blue-800{{else if (eq this.userType 'employer')}}bg-purple-100 text-purple-800{{else}}bg-slate-100 text-slate-800{{/if}}">
                    {{this.userType}}
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class="px-3 py-1 rounded-full text-sm font-medium {{#if this.isActive}}bg-green-100 text-green-800{{else}}bg-red-100 text-red-800{{/if}}">
                    {{#if this.isActive}}Active{{else}}Inactive{{/if}}
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class="px-3 py-1 rounded-full text-sm font-medium {{#if this.isVerified}}bg-green-100 text-green-800{{else}}bg-yellow-100 text-yellow-800{{/if}}">
                    {{#if this.isVerified}}Yes{{else}}No{{/if}}
                  </span>
                </td>
                <td class="px-6 py-4 text-slate-600">{{this.createdAt}}</td>
                <td class="px-6 py-4">
                  <div class="flex gap-2">
                    <button class="text-blue-600 hover:text-blue-700 font-medium text-sm">View</button>
                    {{#unless this.isActive}}
                    <button class="text-green-600 hover:text-green-700 font-medium text-sm">Activate</button>
                    {{/unless}}
                  </div>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
{{> footer}}
</body>
</html>
