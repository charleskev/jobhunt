{{> head}}
<div id="container" class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 pt-[60px]">
    {{> navbar}}
    {{> sidebar-hr}}

    <div class="pt-1 pb-2 px-3 ml-80">
        <!-- Header -->
        <div class="mb-1">
            <h1 class="text-2xl font-bold text-slate-900">📋 Applications</h1>
        </div>

        <!-- Filters and Search -->
        <div class="bg-white rounded-lg shadow-md mb-2 p-3 border border-slate-200">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Search</label>
                    <input type="text" id="searchApp" placeholder="Name or job..." onkeyup="applyAppFilters()" class="w-full px-3 py-1 bg-white border border-slate-300 rounded text-sm text-slate-900 placeholder-slate-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Status</label>
                    <select id="statusAppFilter" onchange="applyAppFilters()" class="w-full px-3 py-1 bg-white border border-slate-300 rounded text-sm text-slate-900 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="">All Status</option>
                        <option value="submitted">Submitted</option>
                        <option value="under_review">Under Review</option>
                        <option value="shortlisted">Shortlisted</option>
                        <option value="interview">Interview</option>
                        <option value="hired">Hired</option>
                        <option value="rejected">Rejected</option>
                    </select>
                </div>
                <div class="flex items-end">
                    <button onclick="resetAppFilters()" class="w-full bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-sm transition font-semibold">
                        Reset
                    </button>
                </div>
            </div>
        </div>

        <!-- Applications Table -->
        <div class="bg-white rounded-lg shadow-md overflow-hidden border border-slate-200 max-h-96">
            <div class="overflow-y-auto h-96">
                <table class="w-full text-sm">
                    <thead class="bg-slate-100 border-b border-slate-200 sticky top-0">
                        <tr>
                            <th class="px-3 py-2 text-left text-xs font-semibold text-slate-900">Applicant</th>
                            <th class="px-3 py-2 text-left text-xs font-semibold text-slate-900">Job Title</th>
                            <th class="px-3 py-2 text-left text-xs font-semibold text-slate-900">Status</th>
                            <th class="px-3 py-2 text-left text-xs font-semibold text-slate-900">Applied</th>
                            <th class="px-3 py-2 text-center text-xs font-semibold text-slate-900">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        {{#if applications}}
                        {{#each applications}}
                        <tr class="hover:bg-slate-50 transition appRow">
                            <td class="px-3 py-2 text-sm">
                                <div class="flex items-center gap-1">
                                    {{#if this.applicant.profilePhoto}}
                                    <img src="{{this.applicant.profilePhoto}}" alt="{{this.applicant.firstName}}" class="w-6 h-6 rounded-full object-cover border border-slate-300">
                                    {{else}}
                                    <div class="w-6 h-6 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center font-bold text-white text-xs">{{substr (concat this.applicant.firstName " " this.applicant.lastName) 0 1}}</div>
                                    {{/if}}
                                    <p class="font-medium text-slate-900">{{this.applicant.firstName}} {{this.applicant.lastName}}</p>
                                </div>
                            </td>
                            <td class="px-3 py-2 text-sm font-medium text-slate-900">{{this.job.title}}</td>
                            <td class="px-3 py-2 text-sm">
                                {{#if (eq this.status "submitted")}}
                                <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-semibold border border-yellow-200">⏳ Submitted</span>
                                {{else if (eq this.status "under_review")}}
                                <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-semibold border border-blue-200">👁️ Under Review</span>
                                {{else if (eq this.status "shortlisted")}}
                                <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold border border-green-200">⭐ Shortlisted</span>
                                {{else if (eq this.status "interview")}}
                                <span class="px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-xs font-semibold border border-indigo-200">📅 Interview</span>
                                {{else if (eq this.status "hired")}}
                                <span class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-semibold border border-emerald-200">✓ Hired</span>
                                {{else if (eq this.status "rejected")}}
                                <span class="px-3 py-1 bg-red-100 text-red-800 rounded-full text-xs font-semibold border border-red-200">✕ Rejected</span>
                                {{/if}}
                            </td>
                            <td class="px-3 py-2 text-sm text-slate-600">
                                {{#if this.createdAt}}
                                {{formatDate this.createdAt}}
                                {{/if}}
                            </td>
                            <td class="px-3 py-2 text-center">
                                <a href="/hr/application-detail/{{this.id}}" class="text-blue-600 hover:text-blue-900 font-medium text-xs">Review</a>
                            </td>
                            </td>
                        </tr>
                        {{/each}}
                        {{else}}
                        <tr>
                            <td colspan="5" class="px-3 py-4 text-center text-slate-600">No applications found</td>
                        </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function applyAppFilters() {
        const search = document.getElementById('searchApp').value;
        const status = document.getElementById('statusAppFilter').value;
        
        const url = new URL(window.location);
        url.searchParams.set('page', '1');
        if (search) url.searchParams.set('search', search);
        if (status) url.searchParams.set('status', status);
        
        window.location.href = url.toString();
    }

    function resetAppFilters() {
        window.location.href = '/hr/applications';
    }

    function openStatusModal(appId) {
        window.location.href = '/hr/application-detail/' + appId;
    }
</script>
    }
</script>

{{> footer}}
