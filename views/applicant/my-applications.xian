<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <title>My Applications - HuntJob</title>
    <style>
        .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .app-card { transition: all 0.3s ease; }
        .app-card:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1); }
    </style>
</head>
<body class="bg-gray-50">
<div class="flex h-screen">
    {{> sidebar-applicant}}
    <div class="flex-1 overflow-y-auto">
        <!-- Gradient Header -->
        <div class="gradient-bg text-white py-8 px-4">
            <div class="max-w-6xl mx-auto">
                <h1 class="text-4xl font-black mb-1">My Applications</h1>
                <p class="text-purple-100">Track and manage all your job applications</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="max-w-6xl mx-auto px-4 py-8">
            <!-- Filters -->
            <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
                <h3 class="font-bold text-gray-900 mb-4">
                    <i class="fas fa-filter mr-2"></i>Filters
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Status</label>
                        <select id="statusFilter" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm">
                            <option value="">All Statuses</option>
                            <option value="submitted">Submitted</option>
                            <option value="under_review">Under Review</option>
                            <option value="shortlisted">Shortlisted</option>
                            <option value="interview">Interview</option>
                            <option value="hired">Hired</option>
                            <option value="rejected">Rejected</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Sort By</label>
                        <select id="sortBy" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm">
                            <option value="recent">Most Recent</option>
                            <option value="oldest">Oldest</option>
                        </select>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Search</label>
                        <input type="text" id="searchApps" placeholder="Search by job title or company..." class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm">
                    </div>
                </div>
            </div>

            <!-- Applications List -->
            {{#if applications}}
            <div class="space-y-4">
                {{#each applications}}
                <div class="app-card bg-white rounded-2xl shadow-md p-6 border-l-4 border-purple-600">
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
                        <div class="flex-1">
                            <h3 class="text-lg font-bold text-gray-900 mb-1">{{job.title}}</h3>
                            <p class="text-sm text-gray-600 flex items-center">
                                <i class="fas fa-building mr-2"></i>
                                {{#if job.poster}}{{job.poster.firstName}} {{job.poster.lastName}}{{else}}{{job.employer.firstName}} {{job.employer.lastName}}{{/if}}
                            </p>
                        </div>
                        <div class="flex items-center gap-2">{{#if (eq status 'hired')}}<span class="px-3 py-1 text-xs font-bold rounded-full bg-green-100 text-green-800"><i class="fas fa-check-circle mr-1"></i>Hired</span>{{else if (eq status 'rejected')}}<span class="px-3 py-1 text-xs font-bold rounded-full bg-red-100 text-red-800"><i class="fas fa-times-circle mr-1"></i>Rejected</span>{{else if (eq status 'interview')}}<span class="px-3 py-1 text-xs font-bold rounded-full bg-blue-100 text-blue-800"><i class="fas fa-users mr-1"></i>Interview</span>{{else if (eq status 'shortlisted')}}<span class="px-3 py-1 text-xs font-bold rounded-full bg-purple-100 text-purple-800"><i class="fas fa-star mr-1"></i>Shortlisted</span>{{else if (eq status 'under_review')}}<span class="px-3 py-1 text-xs font-bold rounded-full bg-cyan-100 text-cyan-800"><i class="fas fa-eye mr-1"></i>Under Review</span>{{else}}<span class="px-3 py-1 text-xs font-bold rounded-full bg-yellow-100 text-yellow-800"><i class="fas fa-hourglass-half mr-1"></i>Submitted</span>{{/if}}</div>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4 text-sm">
                        <div class="bg-gray-50 rounded-lg p-3">
                            <p class="text-gray-600 text-xs font-medium">Applied On</p>
                            <p class="text-gray-900 font-semibold">{{#if createdAt}}{{formatDate createdAt}}{{else}}N/A{{/if}}</p>
                        </div>
                        <div class="bg-gray-50 rounded-lg p-3">
                            <p class="text-gray-600 text-xs font-medium">Job Type</p>
                            <p class="text-gray-900 font-semibold">{{#if job.employmentType}}{{job.employmentType}}{{else}}N/A{{/if}}</p>
                        </div>
                        <div class="bg-gray-50 rounded-lg p-3">
                            <p class="text-gray-600 text-xs font-medium">Location</p>
                            <p class="text-gray-900 font-semibold">{{#if job.municipality}}{{job.municipality}}{{else}}N/A{{/if}}</p>
                        </div>
                        <div class="bg-purple-50 rounded-lg p-3">
                            <p class="text-gray-600 text-xs font-medium">Salary Range</p>
                            <p class="text-purple-600 font-semibold">{{#if job.salaryRange}}{{job.salaryRange}}{{else}}N/A{{/if}}</p>
                        </div>
                    </div>

                    {{#if feedback}}
                    <div class="bg-blue-50 border-l-4 border-blue-600 rounded-lg p-4 mb-4">
                        <p class="text-sm font-bold text-blue-900 mb-1">
                            <i class="fas fa-comment-dots mr-2"></i>Feedback
                        </p>
                        <p class="text-sm text-blue-800">{{feedback}}</p>
                    </div>
                    {{/if}}

                    <div class="flex flex-col sm:flex-row gap-3">
                        <a href="/applicant/applications/{{id}}" class="flex-1 px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-semibold text-center text-sm transition">
                            <i class="fas fa-eye mr-1"></i>View Details
                        </a>
                        {{#if (eq status 'submitted')}}<button onclick="withdrawApplication('{{id}}')" class="flex-1 px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-semibold text-sm transition"><i class="fas fa-trash mr-1"></i>Withdraw</button>{{/if}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <!-- Empty State -->
            <div class="bg-white rounded-2xl shadow-md p-12 text-center">
                <i class="fas fa-inbox text-6xl text-gray-300 mb-4"></i>
                <h3 class="text-2xl font-bold text-gray-900 mb-2">No Applications Yet</h3>
                <p class="text-gray-600 mb-6">You haven't submitted any applications yet. Start browsing jobs to get started!</p>
                <a href="/jobs" class="inline-block bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg font-semibold transition">
                    <i class="fas fa-search mr-2"></i>Browse Jobs
                </a>
            </div>
            {{/if}}
        </div>
    </div>
</div>

{{> footer}}

<script>
    function withdrawApplication(appId) {
        if (confirm('Are you sure you want to withdraw this application?')) {
            fetch(`/applicant/applications/${appId}`, { method: 'DELETE' })
                .then(r => r.json())
                .then(data => {
                    alert(data.message);
                    location.reload();
                })
                .catch(e => console.error(e));
        }
    }
</script>
</body>
</html>
