<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <title>My Profile - HuntJob</title>
    <style>
        .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .form-section { transition: all 0.3s ease; }
        .form-input { transition: all 0.3s ease; }
        .form-input:focus { box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1); }
    </style>
</head>
<body class="bg-gray-50">
<div class="flex h-screen">
    {{> sidebar-applicant}}
    <div class="flex-1 overflow-y-auto">
        <!-- Gradient Header -->
        <div class="gradient-bg text-white py-8 px-4">
            <div class="max-w-6xl mx-auto">
                <h1 class="text-4xl font-black mb-1">My Profile</h1>
                <p class="text-purple-100">Manage your professional profile and documents</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="max-w-6xl mx-auto px-4 py-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Profile Form -->
                <div class="lg:col-span-2">
                    <form id="profileForm" onsubmit="handleProfileUpdate(event)">
                        <!-- Basic Information Section -->
                        <div class="form-section bg-white rounded-2xl shadow-lg p-8 mb-8">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b-2 border-purple-200">
                                <i class="fas fa-user mr-3 text-purple-600"></i>Basic Information
                            </h2>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
                                <div>
                                    <label class="block text-sm font-bold text-gray-900 mb-2">First Name</label>
                                    <input type="text" name="firstName" value="{{user.firstName}}" class="form-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-bold text-gray-900 mb-2">Last Name</label>
                                    <input type="text" name="lastName" value="{{user.lastName}}" class="form-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" required>
                                </div>
                            </div>

                            <div class="mb-6">
                                <label class="block text-sm font-bold text-gray-900 mb-2">Middle Name</label>
                                <input type="text" name="middleName" value="{{user.middleName}}" class="form-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                            </div>

                            <div class="mb-6">
                                <label class="block text-sm font-bold text-gray-900 mb-2">Email Address</label>
                                <div class="relative">
                                    <i class="fas fa-envelope absolute left-4 top-3.5 text-gray-400"></i>
                                    <input type="email" value="{{user.email}}" disabled class="w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl bg-gray-100 text-gray-600 cursor-not-allowed">
                                    <p class="text-xs text-gray-600 mt-1">Email cannot be changed</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-bold text-gray-900 mb-2">Phone Number</label>
                                    <div class="relative">
                                        <i class="fas fa-phone absolute left-4 top-3.5 text-gray-400"></i>
                                        <input type="tel" name="contactNumber" value="{{user.contactNumber}}" placeholder="+1 (555) 000-0000" class="form-input w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-bold text-gray-900 mb-2">Location</label>
                                    <div class="relative">
                                        <i class="fas fa-map-marker-alt absolute left-4 top-3.5 text-gray-400"></i>
                                        <input type="text" name="address" value="{{user.address}}" placeholder="City, Country" class="form-input w-full pl-12 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-6">
                                <div>
                                    <label class="block text-sm font-bold text-gray-900 mb-2">Date of Birth</label>
                                    <input type="date" name="dateOfBirth" value="{{user.dateOfBirth}}" class="form-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                                </div>
                                <div>
                                    <label class="block text-sm font-bold text-gray-900 mb-2">Gender</label>
                                    <select name="gender" class="form-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                                        <option value="">Select Gender</option>
                                        <option value="Male" {{#if (eq user.gender 'Male')}}selected{{/if}}>Male</option>
                                        <option value="Female" {{#if (eq user.gender 'Female')}}selected{{/if}}>Female</option>
                                        <option value="Other" {{#if (eq user.gender 'Other')}}selected{{/if}}>Other</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Professional Information Section -->
                        <div class="form-section bg-white rounded-2xl shadow-lg p-8 mb-8">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b-2 border-purple-200">
                                <i class="fas fa-briefcase mr-3 text-purple-600"></i>Professional Information
                            </h2>

                            <div class="mb-6">
                                <label class="block text-sm font-bold text-gray-900 mb-2">Barangay</label>
                                <input type="text" name="barangay" value="{{user.barangay}}" placeholder="Barangay" class="form-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                            </div>
                        </div>

                        <!-- Save Button -->
                        <button type="submit" class="w-full px-6 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-xl font-bold text-lg transition flex items-center justify-center">
                            <i class="fas fa-save mr-2"></i>Save Changes
                        </button>
                    </form>

                    <script>
                    async function handleProfileUpdate(e) {
                        e.preventDefault();
                        
                        const formData = new FormData(document.getElementById('profileForm'));
                        const data = Object.fromEntries(formData);
                        
                        try {
                            const response = await fetch('/applicant/api/profile', {
                                method: 'PUT',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify(data)
                            });
                            
                            const result = await response.json();
                            
                            if (result.success) {
                                alert('Profile updated successfully!');
                                location.reload();
                            } else {
                                alert('Error: ' + result.message);
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            alert('Failed to update profile');
                        }
                    }
                    </script>
                </div>

                <!-- Sidebar: Profile Picture & Documents -->
                <div class="lg:col-span-1 space-y-8">
                    <!-- Profile Picture -->
                    <div class="bg-white rounded-2xl shadow-lg p-8">
                        <h3 class="text-xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-purple-200">
                            <i class="fas fa-image mr-2 text-purple-600"></i>Profile Picture
                        </h3>

                        <div class="flex flex-col items-center mb-6">
                            {{#if user.profilePhoto}}
                            <img src="/{{user.profilePhoto}}" alt="Profile" class="w-32 h-32 rounded-full object-cover mb-4 border-4 border-purple-200 shadow-md" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="w-32 h-32 rounded-full bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center mb-4 shadow-md hidden">
                                <i class="fas fa-user text-white text-5xl"></i>
                            </div>
                            {{else}}
                            <div class="w-32 h-32 rounded-full bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center mb-4 shadow-md">
                                <i class="fas fa-user text-white text-5xl"></i>
                            </div>
                            {{/if}}
                            <p class="text-sm text-gray-600 text-center">Recommended: Square image, at least 500x500px</p>
                        </div>

                        <form id="profilePictureForm" enctype="multipart/form-data">
                            <div class="border-2 border-dashed border-gray-300 rounded-xl p-4 text-center mb-4 hover:border-purple-500 transition">
                                <input type="file" name="profilePicture" accept="image/*" id="profileInput" class="hidden">
                                <label for="profileInput" class="cursor-pointer">
                                    <i class="fas fa-cloud-upload-alt text-3xl text-gray-400 mb-2"></i>
                                    <p class="text-sm font-medium text-gray-900">Click to upload</p>
                                    <p class="text-xs text-gray-600">or drag and drop</p>
                                </label>
                            </div>
                            <button type="submit" id="uploadPictureBtn" class="w-full px-4 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-semibold transition text-sm">
                                <i class="fas fa-upload mr-2"></i>Upload Picture
                            </button>
                        </form>
                    </div>

                    <!-- Documents -->
                    <div class="bg-white rounded-2xl shadow-lg p-8">
                        <h3 class="text-xl font-bold text-gray-900 mb-6 pb-3 border-b-2 border-purple-200">
                            <i class="fas fa-file-pdf mr-2 text-purple-600"></i>Documents
                        </h3>

                        <div class="space-y-2 mb-6 max-h-48 overflow-y-auto">
                            {{#if documents}}
                            {{#each documents}}
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
                                <div class="flex-1">
                                    <p class="text-sm font-semibold text-gray-900">{{title}}</p>
                                    <p class="text-xs text-gray-600">{{documentType}}</p>
                                </div>
                                <button type="button" onclick="deleteDocument('{{id}}')" class="text-red-600 hover:text-red-700 transition ml-2">
                                    <i class="fas fa-trash text-sm"></i>
                                </button>
                            </div>
                            {{/each}}
                            {{else}}
                            <p class="text-sm text-gray-600 text-center py-4">No documents uploaded yet</p>
                            {{/if}}
                        </div>

                        <form method="POST" action="/applicant/documents" enctype="multipart/form-data" class="space-y-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-900 mb-2">Select Document</label>
                                <input type="file" name="document" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" required>
                                <p class="text-xs text-gray-600 mt-1">PDF, DOC, DOCX (Max 10MB)</p>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-900 mb-2">Document Title</label>
                                <input type="text" name="title" placeholder="e.g., Resume, Certificate..." class="form-input w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" required>
                            </div>
                            <button type="submit" class="w-full px-4 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-semibold transition text-sm">
                                <i class="fas fa-plus mr-2"></i>Upload Document
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{> footer}}

<script>
    function deleteDocument(docId) {
        if (confirm('Are you sure you want to delete this document?')) {
            fetch(`/applicant/documents/${docId}`, { method: 'DELETE' })
                .then(r => r.json())
                .then(data => {
                    alert(data.message);
                    location.reload();
                })
                .catch(e => console.error(e));
        }
    }

    // Handle profile picture upload
    document.getElementById('profilePictureForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const fileInput = document.getElementById('profileInput');
        if (!fileInput.files.length) {
            alert('Please select an image');
            return;
        }

        const formData = new FormData();
        formData.append('profilePicture', fileInput.files[0]);

        const uploadBtn = document.getElementById('uploadPictureBtn');
        const originalText = uploadBtn.innerHTML;
        uploadBtn.disabled = true;
        uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Uploading...';

        try {
            const response = await fetch('/applicant/api/profile/picture', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success) {
                alert('Profile picture uploaded successfully!');
                fileInput.value = ''; // Clear the input
                
                // Reload page to refresh user data and show picture in sidebar
                setTimeout(() => {
                    window.location.href = window.location.href;
                }, 1000);
            } else {
                alert(data.message || 'Failed to upload profile picture');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('An error occurred while uploading the picture');
        } finally {
            uploadBtn.disabled = false;
            uploadBtn.innerHTML = originalText;
        }
    });

    // Show filename when selected
    document.getElementById('profileInput').addEventListener('change', function(e) {
        const fileName = e.target.files[0]?.name || '';
        const label = this.parentElement.querySelector('p:first-of-type');
        if (fileName) {
            label.textContent = `Selected: ${fileName}`;
        } else {
            label.textContent = 'Click to upload';
        }
    });
</script>
</body>
</html>
