<!DOCTYPE html>
<html lang="en">
<head>
    {{> head}}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <title>Saved Jobs - HuntJob</title>
    <style>
        .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .job-card { transition: all 0.3s ease; }
        .job-card:hover { transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15); }
    </style>
</head>
<body class="bg-gray-50">
<div class="flex h-screen">
    {{> sidebar-applicant}}
    <div class="flex-1 overflow-y-auto">
        <!-- Gradient Header -->
        <div class="gradient-bg text-white py-8 px-4">
            <div class="max-w-6xl mx-auto">
                <h1 class="text-4xl font-black mb-1">Saved Jobs</h1>
                <p class="text-purple-100">Review and manage your saved job opportunities</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="max-w-6xl mx-auto px-4 py-8">
            <!-- View Options -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
                <div>
                    <p class="text-gray-600">
                        <i class="fas fa-heart mr-2 text-red-500"></i>
                        <strong class="text-gray-900">{{savedJobs.length}}</strong> saved jobs
                    </p>
                </div>
            </div>

            {{#if savedJobs}}
            <!-- Saved Jobs Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {{#each savedJobs}}
                <div class="job-card bg-white rounded-2xl shadow-md p-6 border-l-4 border-purple-600 hover:shadow-lg">
                    <!-- Header -->
                    <div class="flex justify-between items-start gap-3 mb-4">
                        <div class="flex-1">
                            <h3 class="text-lg font-bold text-gray-900 mb-1">{{job.title}}</h3>
                            <p class="text-sm text-gray-600">
                                <i class="fas fa-building mr-1"></i>
                                {{#if job.poster}}
                                {{job.poster.firstName}} {{job.poster.lastName}}
                                {{else}}
                                {{job.employer.firstName}} {{job.employer.lastName}}
                                {{/if}}
                            </p>
                        </div>
                        <button onclick="removeSavedJob('{{job.id}}')" class="text-red-500 hover:text-red-600 text-xl transition" title="Remove">
                            <i class="fas fa-heart"></i>
                        </button>
                    </div>

                    <!-- Info Grid -->
                    <div class="space-y-2 mb-4 text-sm">
                        <p class="text-gray-700">
                            <i class="fas fa-map-marker-alt mr-2 text-gray-400"></i>
                            {{job.location}}
                        </p>
                        <p class="text-gray-700">
                            <i class="fas fa-briefcase mr-2 text-gray-400"></i>
                            {{job.employmentType}}
                        </p>
                        <p class="text-gray-700">
                            <i class="fas fa-money-bill-alt mr-2 text-gray-400"></i>
                            {{job.salaryRange}}
                        </p>
                    </div>

                    {{#if notes}}
                    <div class="bg-yellow-50 border-l-4 border-yellow-600 rounded-lg p-3 mb-4">
                        <p class="text-sm text-yellow-800">
                            <i class="fas fa-sticky-note mr-2"></i>
                            {{notes}}
                        </p>
                    </div>
                    {{/if}}

                    <!-- Action Buttons -->
                    <div class="flex gap-3">
                        <a href="/jobs/{{job.id}}" class="flex-1 text-center px-3 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-semibold text-sm transition">
                            <i class="fas fa-eye mr-1"></i>View
                        </a>
                        <a href="/applicant/apply?jobId={{job.id}}" class="flex-1 text-center px-3 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg font-semibold text-sm transition">
                            <i class="fas fa-paper-plane mr-1"></i>Apply
                        </a>
                    </div>
                </div>
                {{/each}}
            </div>

            {{else}}
            <!-- Empty State -->
            <div class="bg-white rounded-2xl shadow-md p-12 text-center">
                <i class="fas fa-heart text-6xl text-gray-300 mb-4"></i>
                <h3 class="text-2xl font-bold text-gray-900 mb-2">No Saved Jobs</h3>
                <p class="text-gray-600 mb-6">Start saving jobs to keep track of opportunities that interest you</p>
                <a href="/jobs" class="inline-block px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-semibold transition">
                    <i class="fas fa-search mr-2"></i>Browse Jobs
                </a>
            </div>
            {{/if}}
        </div>
    </div>
</div>

{{> footer}}

<script>
    function removeSavedJob(jobId) {
        if (confirm('Remove this job from your saved list?')) {
            fetch(`/applicant/api/saved-jobs/${jobId}`, { method: 'DELETE' })
                .then(r => r.json())
                .then(data => {
                    alert(data.message);
                    location.reload();
                })
                .catch(e => console.error(e));
        }
    }
</script>
</body>
</html>
