<!-- Sidebar for Admin -->
<aside class="w-64 bg-gray-900 text-white shadow-lg self-start overflow-y-auto" style="position:sticky; top:60px;">
    <div class="p-6 border-b border-gray-700">
        <h2 class="text-2xl font-bold">Admin Panel</h2>
        <p class="text-sm text-gray-400 mt-1">System Management</p>
    </div>

    <nav class="p-4 space-y-2">
        <!-- Dashboard -->
        <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
            <span class="text-xl">📊</span>
            <span class="font-medium">Dashboard</span>
        </a>

        <!-- User Management -->
        <div class="mt-6">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide px-4 mb-2">User Management</p>
            <a href="/admin/users-list" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">👥</span>
                <span class="font-medium">Users</span>
                <span class="ml-auto bg-blue-600 text-white text-xs px-2 py-1 rounded-full">1.2K</span>
            </a>
            <a href="/admin/users-list?role=hr" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">👨‍💼</span>
                <span class="font-medium">HR Managers</span>
            </a>
            <a href="/admin/users-list?role=manager" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">👨‍💻</span>
                <span class="font-medium">Managers</span>
            </a>
            <a href="/admin/users-list?status=suspended" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">🚫</span>
                <span class="font-medium">Suspended</span>
                <span class="ml-auto bg-red-600 text-white text-xs px-2 py-1 rounded-full">3</span>
            </a>
        </div>

        <!-- System Management -->
        <div class="mt-6">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide px-4 mb-2">System</p>
            <a href="/admin/audit-logs" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">📋</span>
                <span class="font-medium">Audit Logs</span>
            </a>
            <a href="/admin/system-settings" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">⚙️</span>
                <span class="font-medium">Settings</span>
            </a>
            <a href="/admin/backup" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">💾</span>
                <span class="font-medium">Backup</span>
            </a>
        </div>

        <!-- Content Management -->
        <div class="mt-6">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide px-4 mb-2">Content</p>
            <a href="/admin/jobs" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">📝</span>
                <span class="font-medium">All Jobs</span>
                <span class="ml-auto bg-green-600 text-white text-xs px-2 py-1 rounded-full">{{totalJobs}}</span>
            </a>
            <a href="/admin/applications" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">📊</span>
                <span class="font-medium">Applications</span>
                <span class="ml-auto bg-purple-600 text-white text-xs px-2 py-1 rounded-full">{{totalApplications}}</span>
            </a>
        </div>

        <!-- Reports & Analytics -->
        <div class="mt-6">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide px-4 mb-2">Analytics</p>
            <a href="/admin/reports" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">📈</span>
                <span class="font-medium">Reports</span>
            </a>
            <a href="/admin/analytics" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">📊</span>
                <span class="font-medium">Analytics</span>
            </a>
            <a href="/admin/activity" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">🔍</span>
                <span class="font-medium">Activity Log</span>
            </a>
        </div>

        <!-- Security -->
        <div class="mt-6">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide px-4 mb-2">Security</p>
            <a href="/admin/api-keys" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">🔑</span>
                <span class="font-medium">API Keys</span>
            </a>
            <a href="/admin/security" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
                <span class="text-xl">🔒</span>
                <span class="font-medium">Security</span>
            </a>
        </div>
    </nav>

    <!-- Divider -->
    <hr class="my-4 border-gray-700">

    <!-- System Status -->
    <div class="p-4 bg-gray-800 rounded-lg m-4">
        <p class="text-xs font-semibold text-gray-400 mb-2">System Status</p>
        <div class="space-y-2">
            <div class="flex items-center justify-between text-xs">
                <span class="text-gray-300">Database</span>
                <span class="flex items-center gap-1">
                    <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                    <span class="text-green-400">Online</span>
                </span>
            </div>
            <div class="flex items-center justify-between text-xs">
                <span class="text-gray-300">Server</span>
                <span class="flex items-center gap-1">
                    <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                    <span class="text-green-400">Healthy</span>
                </span>
            </div>
        </div>
    </div>

    <!-- Footer Section -->
    <div class="p-4 space-y-2">
        <a href="/admin/profile" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
            <span class="text-xl">👤</span>
            <span class="font-medium text-sm">My Profile</span>
        </a>
        <a href="/admin/settings" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
            <span class="text-xl">⚙️</span>
            <span class="font-medium text-sm">Preferences</span>
        </a>
        <a href="/admin/help" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-800 text-gray-100 hover:text-white transition">
            <span class="text-xl">❓</span>
            <span class="font-medium text-sm">Help</span>
        </a>
        <a href="/auth/logout" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-red-900 text-red-300 hover:text-red-100 transition">
            <span class="text-xl">🚪</span>
            <span class="font-medium text-sm">Logout</span>
        </a>
    </div>
</aside>
