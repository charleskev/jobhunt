<aside class="w-64 bg-white shadow-lg self-start overflow-y-auto" style="position:sticky; top:60px;">
    <div class="p-6">
        <!-- Profile Section -->
        {{#if user}}
        <div class="text-center mb-6 pb-6 border-b border-gray-200">
            {{#if user.profilePhoto}}
            <img src="/{{user.profilePhoto}}?t={{timestamp}}" alt="{{user.firstName}} {{user.lastName}}" class="w-20 h-20 rounded-full mx-auto mb-3 object-cover border-2 border-purple-300 shadow-md" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <div class="w-20 h-20 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full mx-auto mb-3 flex items-center justify-center text-white text-2xl font-bold hidden">
                {{#if user.firstName}}{{user.firstName.[0]}}{{/if}}{{#if user.lastName}}{{user.lastName.[0]}}{{/if}}
            </div>
            {{else}}
            <div class="w-20 h-20 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full mx-auto mb-3 flex items-center justify-center text-white text-2xl font-bold">
                {{#if user.firstName}}{{user.firstName.[0]}}{{/if}}{{#if user.lastName}}{{user.lastName.[0]}}{{/if}}
            </div>
            {{/if}}
            <h3 class="font-bold text-gray-800">{{user.firstName}} {{user.lastName}}</h3>
            <p class="text-sm text-gray-500">{{user.email}}</p>
            <div class="mt-3">
                <span class="inline-block bg-purple-100 text-purple-600 text-xs font-semibold px-3 py-1 rounded-full">
                    <i class="fas fa-user mr-1"></i>Applicant
                </span>
            </div>
        </div>
        {{else}}
        <div class="text-center mb-6 pb-6 border-b border-gray-200">
            <div class="w-20 h-20 bg-gray-200 rounded-full mx-auto mb-3 flex items-center justify-center text-gray-600 text-2xl font-bold">A</div>
            <h3 class="font-bold text-gray-800">Welcome</h3>
            <p class="text-sm text-gray-500">Please log in to apply</p>
            <div class="mt-3 flex gap-2 justify-center">
                <a href="/auth/login" class="px-3 py-1 bg-purple-600 text-white rounded-full text-sm">Login</a>
                <a href="/auth/register" class="px-3 py-1 bg-gray-100 text-gray-800 rounded-full text-sm">Register</a>
            </div>
        </div>
        {{/if}}

        <!-- Navigation Menu -->
        <nav class="space-y-1">
            <a href="/applicant/dashboard" class="flex items-center px-4 py-3 text-slate-700 hover:bg-sky-50 hover:text-sky-600 rounded-xl transition group">
                <i class="fas fa-tachometer-alt w-5 group-hover:scale-110 transition"></i>
                <span class="ml-3 font-medium">Dashboard</span>
            </a>
            
            <a href="/jobs" class="flex items-center px-4 py-3 text-gray-700 hover:bg-purple-50 hover:text-purple-600 rounded-lg transition group">
                <i class="fas fa-search w-5 group-hover:scale-110 transition"></i>
                <span class="ml-3 font-medium">Browse Jobs</span>
            </a>
            
            <a href="/applicant/my-applications" class="flex items-center px-4 py-3 text-gray-700 hover:bg-purple-50 hover:text-purple-600 rounded-lg transition group">
                <i class="fas fa-file-alt w-5 group-hover:scale-110 transition"></i>
                <span class="ml-3 font-medium">My Applications</span>
                {{#if applicationCount}}
                <span class="ml-auto bg-purple-600 text-white text-xs font-bold px-2 py-1 rounded-full">
                    {{applicationCount}}
                </span>
                {{/if}}
            </a>
            
            <a href="/applicant/saved-jobs" class="flex items-center px-4 py-3 text-gray-700 hover:bg-purple-50 hover:text-purple-600 rounded-lg transition group">
                <i class="fas fa-heart w-5 group-hover:scale-110 transition"></i>
                <span class="ml-3 font-medium">Saved Jobs</span>
            </a>
            
            <a href="/applicant/profile" class="flex items-center px-4 py-3 text-gray-700 hover:bg-purple-50 hover:text-purple-600 rounded-lg transition group">
                <i class="fas fa-user-edit w-5 group-hover:scale-110 transition"></i>
                <span class="ml-3 font-medium">My Profile</span>
            </a>
            
            <a href="/applicant/notifications" class="flex items-center px-4 py-3 text-gray-700 hover:bg-purple-50 hover:text-purple-600 rounded-lg transition group">
                <i class="fas fa-bell w-5 group-hover:scale-110 transition"></i>
                <span class="ml-3 font-medium">Notifications</span>
                {{#if unreadCount}}
                <span class="ml-auto bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-full">
                    {{unreadCount}}
                </span>
                {{/if}}
            </a>
        </nav>

        <!-- Logout Button -->
        <div class="mt-6 pt-6 border-t border-gray-200">
            <a href="/auth/logout" class="flex items-center px-4 py-3 text-red-600 hover:bg-red-50 rounded-lg transition group">
                <i class="fas fa-sign-out-alt w-5 group-hover:scale-110 transition"></i>
                <span class="ml-3 font-medium">Logout</span>
            </a>
        </div>
    </div>
</aside>