<!-- Sidebar for HR Manager -->
<aside class="w-64 bg-white shadow-lg self-start overflow-y-auto" style="position:sticky; top:60px;">
    <div class="p-6 border-b border-gray-200">
        <h2 class="text-2xl font-bold text-gray-900">HR Dashboard</h2>
        <p class="text-sm text-gray-600 mt-1">Recruitment Hub</p>
    </div>

    <nav class="p-4 space-y-2">
        <!-- Dashboard -->
        <a href="/hr/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-green-50 text-gray-700 hover:text-green-600 transition">
            <span class="text-xl">📊</span>
            <span class="font-medium">Dashboard</span>
        </a>

        <!-- Jobs Management -->
        <div class="mt-6">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide px-4 mb-2">Jobs</p>
            <a href="/hr/jobs-list" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-green-50 text-gray-700 hover:text-green-600 transition">
                <span class="text-xl">📋</span>
                <span class="font-medium">All Jobs</span>
            </a>
            <a href="/hr/job-form" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-green-50 text-gray-700 hover:text-green-600 transition">
                <span class="text-xl">➕</span>
                <span class="font-medium">Post Municipality Job</span>
            </a>
            <a href="/hr/department-job-form" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-green-50 text-gray-700 hover:text-green-600 transition">
                <span class="text-xl">🏢</span>
                <span class="font-medium">Post Department Job</span>
            </a>
        </div>

        <!-- Reports -->
        <div class="mt-6">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide px-4 mb-2">Reports</p>
            <a href="/hr/reports" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-green-50 text-gray-700 hover:text-green-600 transition">
                <span class="text-xl">📊</span>
                <span class="font-medium">View Reports</span>
            </a>
        </div>
    </nav>

    <!-- Divider -->
    <hr class="my-4">

    <!-- Footer Section -->
    <div class="p-4 space-y-2">
        <a href="/auth/logout" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-red-50 text-red-600 hover:text-red-700 transition">
            <span class="text-xl">🚪</span>
            <span class="font-medium text-sm">Logout</span>
        </a>
    </div>
</aside>
